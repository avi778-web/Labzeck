  <div class="modal-backdrop" id="successOverlay" role="presentation"><section class="success-modal" role="dialog" aria-modal="true" aria-labelledby="successTitle"><div class="success-mark" aria-hidden="true">✓</div><h2 id="successTitle" tabindex="-1">Payment confirmed</h2><p>Your order has been saved and is ready for artwork review.</p><div class="success-details" id="successDetails"></div><div class="success-actions"><a class="primary-button" id="successWhatsApp" href="https://wa.me/918447459316" target="_blank" rel="noopener noreferrer">Message the team</a><button class="secondary-button" id="successClose" type="button">Continue shopping</button></div></section></div>

  <script type="module">
    import { upload } from '/assets/blob-client.js';
    (() => {
      const pricePerPiece = 70;
      const minimumQuantity = 10;
      const maximumQuantity = 5000;
      const quantityInput = document.getElementById('quantity');
      const summaryQuantity = document.getElementById('summaryQuantity');
      const summaryItems = document.getElementById('summaryItems');
      const summaryTotal = document.getElementById('summaryTotal');
      const payButton = document.getElementById('payButton');
      const form = document.getElementById('idCardOrderForm');
      const formStatus = document.getElementById('formStatus');
      const fileRefs = { cardDesign: null, lanyardLogo: null };
      let paymentInProgress = false;
      let checkoutToken = null;
      let razorpayLoaderPromise = null;
      let lastHistoryPhone = '';

      const money = amount => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(amount);
      const setQuantity = value => {
        const quantity = Math.max(minimumQuantity, Math.min(maximumQuantity, Math.floor(Number(value) || minimumQuantity)));
        quantityInput.value = String(quantity);
        summaryQuantity.textContent = String(quantity);
        summaryItems.textContent = money(quantity * pricePerPiece);
        summaryTotal.textContent = money(quantity * pricePerPiece);
        payButton.innerHTML = `Pay ${money(quantity * pricePerPiece)} securely with Razorpay <span aria-hidden="true">→</span>`;
      };
      quantityInput.addEventListener('input', () => setQuantity(quantityInput.value));
      quantityInput.addEventListener('change', () => setQuantity(quantityInput.value));
      document.getElementById('quantityDown').addEventListener('click', () => setQuantity(Number(quantityInput.value) - 1));
      document.getElementById('quantityUp').addEventListener('click', () => setQuantity(Number(quantityInput.value) + 1));

      function formatSize(bytes) { return bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : `${(bytes / (1024 * 1024)).toFixed(1)} MB`; }
      function createUploadId() {
        if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, character => {
          const random = Math.random() * 16 | 0;
          return (character === 'x' ? random : (random & 3 | 8)).toString(16);
        });
      }
      const extensionTypes = { pdf: 'application/pdf', ai: 'application/postscript', psd: 'image/vnd.adobe.photoshop', png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp' };
      async function uploadArtwork(file, category, statusNode, inputNode) {
        const key = category === 'card-design' ? 'cardDesign' : 'lanyardLogo';
        const label = category === 'card-design' ? 'ID card artwork' : 'Lanyard artwork';
        if (!file) { fileRefs[key] = null; statusNode.textContent = 'No file selected'; statusNode.className = 'upload-status'; updatePayAvailability(); return; }
        if (file.size > 10 * 1024 * 1024) {
          fileRefs[key] = null;
          statusNode.textContent = 'Choose a file under 10 MB.';
          statusNode.className = 'upload-status error';
          inputNode.value = '';
          updatePayAvailability();
          return;
        }
        const extension = file.name.split('.').pop().toLowerCase();
        const contentType = extensionTypes[extension];
        if (!contentType) {
          fileRefs[key] = null;
          statusNode.textContent = 'Use a PDF, AI, PSD, PNG, JPG, or WEBP file.';
          statusNode.className = 'upload-status error';
          inputNode.value = '';
          updatePayAvailability();
          return;
        }
        fileRefs[key] = null;
        statusNode.textContent = `Uploading ${label.toLowerCase()} privately…`;
        statusNode.className = 'upload-status';
        updatePayAvailability();
        try {
          const pathname = `id-card-lanyard/${category}/${createUploadId()}.${extension}`;
          const blob = await upload(pathname, file, {
            access: 'private',
            handleUploadUrl: '/api/id-card/upload-token',
            clientPayload: JSON.stringify({ category }),
            contentType,
            multipart: file.size > 5 * 1024 * 1024,
            onUploadProgress: progress => { statusNode.textContent = `Uploading privately… ${Math.round(progress.percentage)}%`; }
          });
          const signResponse = await fetch('/api/id-card/sign-upload', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pathname: blob.pathname, category }) });
          const result = await signResponse.json();
          if (!signResponse.ok || !result.ok) throw new Error(result.message || 'Upload could not be verified. Please try again.');
          fileRefs[key] = { pathname: result.pathname, signature: result.signature };
          statusNode.textContent = `Ready · ${file.name} · ${formatSize(file.size)}`;
          statusNode.className = 'upload-status ready';
        } catch (error) {
          statusNode.textContent = error.message || 'Upload failed. Please try again.';
          statusNode.className = 'upload-status error';
          inputNode.value = '';
        }
        updatePayAvailability();
      }
      function setupUpload(inputId, dropId, statusId, category) {
        const input = document.getElementById(inputId);
        const drop = document.getElementById(dropId);
        const status = document.getElementById(statusId);
        input.addEventListener('change', () => uploadArtwork(input.files && input.files[0], category, status, input));
        drop.addEventListener('dragover', event => { event.preventDefault(); drop.classList.add('dragging'); });
        drop.addEventListener('dragleave', () => drop.classList.remove('dragging'));
        drop.addEventListener('drop', event => {
          event.preventDefault();
          drop.classList.remove('dragging');
          const file = event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files[0];
          if (!file) return;
          const transfer = new DataTransfer();
          transfer.items.add(file);
          input.files = transfer.files;
          uploadArtwork(file, category, status, input);
        });
      }
      setupUpload('cardDesignFile', 'cardUploadDrop', 'cardUploadStatus', 'card-design');
      setupUpload('lanyardLogoFile', 'lanyardUploadDrop', 'lanyardUploadStatus', 'lanyard-logo');
      function updatePayAvailability() { payButton.disabled = paymentInProgress || !fileRefs.cardDesign || !fileRefs.lanyardLogo; }

      async function parseResponse(response) {
        const text = await response.text();
        try { return text ? JSON.parse(text) : {}; } catch (_) { return { message: `The server returned ${response.status}.` }; }
      }
      function loadRazorpay() {
        if (window.Razorpay) return Promise.resolve(window.Razorpay);
        if (razorpayLoaderPromise) return razorpayLoaderPromise;
        razorpayLoaderPromise = new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://checkout.razorpay.com/v1/checkout.js';
          script.async = true;
          script.referrerPolicy = 'strict-origin-when-cross-origin';
          script.onload = () => window.Razorpay ? resolve(window.Razorpay) : reject(new Error('Secure checkout could not be loaded.'));
          script.onerror = () => reject(new Error('Secure checkout could not be loaded. Please check your connection.'));
          document.head.appendChild(script);
        });
        return razorpayLoaderPromise;
      }
      function setPaymentState(isBusy) {
        paymentInProgress = isBusy;
        payButton.disabled = isBusy || !fileRefs.cardDesign || !fileRefs.lanyardLogo;
        payButton.setAttribute('aria-busy', String(isBusy));
        if (!isBusy) setQuantity(quantityInput.value);
      }
      function showSuccess(result, quantity, total) {
        const orderId = result.trackingId || result.orderId || 'Order received';
        document.getElementById('successDetails').textContent = `Tracking ID: ${orderId}\nQuantity: ${quantity} sets\nTotal paid: ${money(total)}\nStatus: Order received\n${result.deliveryMessage || 'Our team will review your artwork before printing.'}`;
        const message = `Hello SK Graphics, my ID card order ${orderId} is confirmed for ${quantity} sets (₹${total}).`;
        document.getElementById('successWhatsApp').href = `https://wa.me/918447459316?text=${encodeURIComponent(message)}`;
        const overlay = document.getElementById('successOverlay');
        overlay.classList.add('open');
        document.getElementById('successTitle').focus();
      }
      function closeSuccess() {
        document.getElementById('successOverlay').classList.remove('open');
        document.getElementById('custom-order').scrollIntoView({ behavior: 'smooth' });
      }
      document.getElementById('successClose').addEventListener('click', closeSuccess);
      document.getElementById('successOverlay').addEventListener('click', event => { if (event.target.id === 'successOverlay') closeSuccess(); });
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && document.getElementById('successOverlay').classList.contains('open')) closeSuccess(); });

      form.addEventListener('submit', async event => {
        event.preventDefault();
        formStatus.textContent = '';
        formStatus.className = 'form-status';
        if (!form.reportValidity()) return;
        if (!fileRefs.cardDesign || !fileRefs.lanyardLogo) {
          formStatus.textContent = 'Upload both the ID card artwork and lanyard artwork before checkout.';
          return;
        }
        if (paymentInProgress) return;
        const phone = document.getElementById('phone').value.trim();
        const phoneDigits = phone.replace(/\D/g, '');
        if (phoneDigits.length < 10 || phoneDigits.length > 15) {
          formStatus.textContent = 'Enter a valid mobile number with 10 to 15 digits.';
          document.getElementById('phone').focus();
          return;
        }
        const quantity = Math.max(minimumQuantity, Math.min(maximumQuantity, Number(quantityInput.value) || minimumQuantity));
        const total = quantity * pricePerPiece;
        setPaymentState(true);
        payButton.textContent = 'Preparing secure checkout…';
        try {
          checkoutToken = checkoutToken || createUploadId();
          const response = await fetch('/api/id-card/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              idempotencyKey: checkoutToken,
              quantity,
              name: document.getElementById('cardHolderText').value.trim(),
              cardHolderText: document.getElementById('cardHolderText').value.trim(),
              designation: document.getElementById('designation').value.trim(),
              phone,
              address: document.getElementById('address').value.trim(),
              lanyardText: document.getElementById('lanyardText').value.trim(),
              instructions: document.getElementById('instructions').value.trim(),
              uploads: fileRefs
            })
          });
          const order = await parseResponse(response);
          if (!response.ok || !order.ok) throw new Error(order.message || 'Unable to start checkout. Please try again.');
          const Razorpay = await loadRazorpay();
          const checkout = new Razorpay({
            key: order.keyId,
            amount: order.amount,
            currency: order.currency,
            name: 'SK Graphics',
            description: `${quantity} custom ID card sets with branded lanyards`,
            order_id: order.razorpayOrderId,
            prefill: { name: document.getElementById('cardHolderText').value.trim(), contact: phone },
            notes: { product: 'Custom ID Card with Branded Lanyard', quantity: String(quantity) },
            theme: { color: '#2167b2' },
            handler: async payment => {
              formStatus.textContent = 'Verifying payment securely…';
              try {
                const verifyResponse = await fetch('/api/id-card/verify', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...payment, orderRecordId: order.orderRecordId }) });
                const verified = await parseResponse(verifyResponse);
                if (!verifyResponse.ok || !verified.confirmed) throw new Error(verified.message || 'Payment could not be verified yet. Please contact support with your payment receipt.');
                formStatus.textContent = 'Payment verified. Your order is confirmed.';
                formStatus.className = 'form-status success';
                checkoutToken = null;
                setPaymentState(false);
                showSuccess(verified, quantity, total);
              } catch (error) {
                formStatus.textContent = error.message || 'Payment verification failed. Please contact support.';
                formStatus.className = 'form-status';
                checkoutToken = null;
                setPaymentState(false);
              }
            },
            modal: { ondismiss: () => { checkoutToken = null; formStatus.textContent = 'Checkout closed. Your payment was not confirmed.'; setPaymentState(false); } }
          });
          checkout.on('payment.failed', () => { checkoutToken = null; formStatus.textContent = 'Payment was not completed. You can try again securely.'; setPaymentState(false); });
          checkout.open();
        } catch (error) {
          formStatus.textContent = error.message || 'Unable to start payment. Please try again.';
          setPaymentState(false);
        }
      });

      function renderHistory(container, orders) {
        container.replaceChildren();
        if (!orders.length) return;
        const statusLabels = { received: 'Order received', processing: 'In production / packing', completed: 'Marked complete' };
        orders.forEach(order => {
          const card = document.createElement('article');
          card.className = 'history-result';
          const heading = document.createElement('strong');
          const date = order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Date unavailable';
          heading.textContent = `Order #${order.id} · ${date}`;
          const description = document.createElement('p');
          const items = (order.items || []).map(item => `${item.name} × ${item.quantity}`).join(', ') || 'Order details unavailable';
          const lines = [`Status: ${statusLabels[order.status] || order.status || 'Order received'}`, items, `Total: ${money(Number(order.total) || 0)}`];
          if (order.deliveryEstimate) lines.push(order.deliveryEstimate);
          description.textContent = lines.join('\n');
          card.append(heading, description);
          container.append(card);
        });
      }
      async function lookupOrders(phone, statusNode, resultsNode, button) {
        const digits = phone.replace(/\D/g, '');
        if (digits.length < 10 || digits.length > 15) throw new Error('Enter a valid mobile number with 10 to 15 digits.');
        if (button) button.disabled = true;
        statusNode.textContent = 'Checking recent orders…';
        resultsNode.replaceChildren();
        try {
          const response = await fetch('/api/support/orders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone }) });
          const result = await parseResponse(response);
          if (!response.ok || !result.ok) throw new Error(result.message || 'Could not check order status.');
          if (!result.orders.length) statusNode.textContent = 'No orders found for this number. Check the mobile used at checkout or contact our team.';
          else { statusNode.textContent = `Found ${result.orders.length} recent ${result.orders.length === 1 ? 'order' : 'orders'}.`; renderHistory(resultsNode, result.orders); }
          return result.orders;
        } finally { if (button) button.disabled = false; }
      }
      const checkoutPhone = document.getElementById('phone');
      const checkoutHistory = document.getElementById('checkoutHistory');
      const checkoutHistoryResults = document.getElementById('checkoutHistoryResults');
      checkoutPhone.addEventListener('input', () => {
        lastHistoryPhone = '';
        checkoutHistory.textContent = '';
        checkoutHistoryResults.replaceChildren();
      });
      checkoutPhone.addEventListener('blur', async () => {
        const digits = checkoutPhone.value.replace(/\D/g, '');
        if (digits.length < 10 || digits.length > 15 || digits === lastHistoryPhone) return;
        lastHistoryPhone = digits;
        try { await lookupOrders(checkoutPhone.value.trim(), checkoutHistory, checkoutHistoryResults, null); }
        catch (error) { checkoutHistory.textContent = error.message || 'Order history could not be checked.'; }
      });
      document.getElementById('trackForm').addEventListener('submit', async event => {
        event.preventDefault();
        const status = document.getElementById('trackStatus');
        try { await lookupOrders(document.getElementById('trackPhone').value.trim(), status, document.getElementById('trackResults'), document.getElementById('trackButton')); }
        catch (error) { status.textContent = error.message || 'Could not check order status. Please try again.'; }
      });

      (() => {
        const panel = document.getElementById('supportPanel');
        const toggle = document.getElementById('supportToggle');
        const close = document.getElementById('supportClose');
        const supportHeaderOpen = document.getElementById('supportHeaderOpen');
        const supportInlineOpen = document.getElementById('supportInlineOpen');
        const log = document.getElementById('supportLog');
        const orderForm = document.getElementById('supportOrderForm');
        const askForm = document.getElementById('supportAskForm');
        const orderInput = document.getElementById('supportPhone');
        const orderStatus = document.getElementById('supportOrderStatus');
        const askInput = document.getElementById('supportQuestion');
        const askStatus = document.getElementById('supportAskStatus');
        const orderButton = document.getElementById('supportOrderButton');
        const sendButton = document.getElementById('supportSendButton');
        let activeTrigger = toggle;
        const obstructingSections = [document.querySelector('.hero'), document.getElementById('custom-order')];
        const sectionVisibility = new Map();
        function addMessage(text, role = 'assistant') { const node = document.createElement('div'); node.className = `chat-message${role === 'user' ? ' user' : ''}`; node.textContent = text; log.append(node); log.scrollTop = log.scrollHeight; }
        function setOpen(open, trigger = toggle) {
          if (open) activeTrigger = trigger;
          panel.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
          if (open) close.focus();
          else if (!toggle.hidden) toggle.focus();
          else activeTrigger.focus();
        }
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => sectionVisibility.set(entry.target, entry.isIntersecting));
            toggle.hidden = panel.hidden && [...sectionVisibility.values()].some(Boolean);
          }, { threshold: 0.04 });
          obstructingSections.forEach(section => observer.observe(section));
        }
        addMessage('Hi, I can help with printing, artwork, delivery, and order status. Choose a topic or ask me anything.');
        toggle.addEventListener('click', () => setOpen(panel.hidden, toggle));
        supportHeaderOpen.addEventListener('click', () => setOpen(true, supportHeaderOpen));
        supportInlineOpen.addEventListener('click', () => setOpen(true, supportInlineOpen));
        close.addEventListener('click', () => setOpen(false));
        document.addEventListener('keydown', event => { if (event.key === 'Escape' && !panel.hidden) setOpen(false); });
        panel.querySelector('.support-menu').addEventListener('click', async event => {
          const button = event.target.closest('[data-support-action]');
          if (!button) return;
          const action = button.dataset.supportAction;
          if (action === 'track') { addMessage('Track an order', 'user'); addMessage('Enter the mobile number used at checkout. I’ll look up your recent orders.'); orderForm.hidden = false; orderStatus.textContent = ''; orderInput.focus(); return; }
          if (action === 'other') { addMessage('Other question', 'user'); addMessage('Type your question below and I’ll do my best to help.'); askForm.hidden = false; askInput.focus(); return; }
          const questions = { products: 'What products and pricing does SK Graphics offer?', delivery: 'How does delivery timing work for a custom printing order?', artwork: 'What artwork file types and print preparation do you recommend?', returns: 'How do returns, refunds, or exchanges work?' };
          const prompt = questions[action];
          if (prompt) await sendQuestion(prompt, true);
        });
        async function sendQuestion(question, showUserMessage) {
          if (showUserMessage) addMessage(question, 'user');
          sendButton.disabled = true;
          askStatus.textContent = 'Checking that for you…';
          try {
            const response = await fetch('/api/support/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: question }) });
            const result = await parseResponse(response);
            if (!response.ok || !result.ok) throw new Error(result.message || 'Support is temporarily unavailable.');
            addMessage(result.reply);
            askStatus.textContent = '';
          } catch (error) { askStatus.textContent = error.message || 'Support is temporarily unavailable. Please call our team.'; }
          finally { sendButton.disabled = false; }
        }
        askForm.addEventListener('submit', async event => { event.preventDefault(); const question = askInput.value.trim(); if (!question) return; askInput.value = ''; await sendQuestion(question, true); });
        orderForm.addEventListener('submit', async event => {
          event.preventDefault();
          orderButton.disabled = true;
          orderStatus.textContent = 'Checking your recent orders…';
          try {
            const orders = await lookupOrders(orderInput.value.trim(), orderStatus, document.createElement('div'), null);
            addMessage('Check order status', 'user');
            if (!orders.length) addMessage('I couldn’t find an order with that phone number. Check the number used at checkout or contact our team.');
            else orders.forEach(order => {
              const status = { received: 'Order received', processing: 'In production / packing', completed: 'Marked complete' }[order.status] || order.status;
              const products = (order.items || []).map(item => `${item.name} × ${item.quantity}`).join(', ') || 'Order details unavailable';
              const date = order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Date unavailable';
              addMessage(`Order #${order.id} · ${date}\nStatus: ${status}\n${products}\nTotal: ${money(Number(order.total) || 0)}${order.deliveryEstimate ? `\n${order.deliveryEstimate}` : ''}`);
            });
            orderStatus.textContent = '';
          } catch (error) { orderStatus.textContent = error.message || 'Could not check order status.'; }
          finally { orderButton.disabled = false; }
        });
      })();

      setQuantity(minimumQuantity);
      updatePayAvailability();
    })();
  </script>
</body>
</html>
