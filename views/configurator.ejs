<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>SK Graphics Configurator</title>
<style>
:root{--ink:#172033;--muted:#68728a;--line:#e5e8f0;--soft:#f7f8fc;--purple:#5b4bdb;--violet:#8b5cf6;--green:#17855b}*{box-sizing:border-box}body{margin:0;color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;background:linear-gradient(135deg,#f8f9ff,#fff 45%,#f5f2ff)}button,input,select,textarea{font:inherit}button{cursor:pointer}.shell{max-width:1440px;margin:auto;padding:28px 32px 56px}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:32px}.brand{font-weight:900;letter-spacing:-.04em;font-size:24px}.brand span{color:var(--purple)}.eyebrow{color:var(--purple);font-weight:800;letter-spacing:.15em;text-transform:uppercase;font-size:11px}.topbar a{color:var(--muted);text-decoration:none}.hero{margin-bottom:28px}.hero h1{font-size:clamp(32px,5vw,62px);line-height:1.02;letter-spacing:-.06em;margin:8px 0 14px;max-width:850px}.hero p{max-width:670px;color:var(--muted);font-size:17px}.layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(330px,.65fr);gap:24px;align-items:start}.panel,.summary{background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:0 18px 50px #25204a0b}.panel{padding:24px}.summary{padding:24px;position:sticky;top:18px}.tabs{display:flex;gap:8px;overflow:auto;padding-bottom:18px;border-bottom:1px solid var(--line)}.tab{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:999px;padding:10px 15px;white-space:nowrap}.tab.active{background:var(--ink);color:#fff;border-color:var(--ink)}.config-head{display:flex;justify-content:space-between;gap:12px;align-items:start;margin:24px 0}.config-head h2,.summary h2{margin:0;font-size:24px;letter-spacing:-.04em}.config-head p{color:var(--muted);margin:4px 0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.field{display:grid;gap:8px}.field.full{grid-column:1/-1}.field label{font-weight:800;font-size:13px}.field select,.field input,.field textarea{width:100%;border:1px solid var(--line);border-radius:12px;padding:12px;background:#fff;color:var(--ink);outline:none}.field select:focus,.field input:focus,.field textarea:focus{border-color:var(--purple);box-shadow:0 0 0 3px #5b4bdb18}.hint{font-size:12px;color:var(--muted)}.choice-row{display:flex;flex-wrap:wrap;gap:8px}.choice{border:1px solid var(--line);background:#fff;border-radius:12px;padding:10px 12px;color:var(--muted);text-align:left}.choice.active{border-color:var(--purple);background:#f1efff;color:var(--purple);font-weight:800}.quantity{display:flex;gap:8px;flex-wrap:wrap}.qty{border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 13px}.qty.active{background:var(--purple);border-color:var(--purple);color:#fff}.upload{border:1.5px dashed #aeb4cb;border-radius:14px;padding:20px;text-align:center;background:var(--soft);color:var(--muted)}.upload input{display:none}.upload strong{color:var(--purple)}.preview{margin-top:10px;font-size:12px;color:var(--green)}.toggle{display:flex;gap:10px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:12px}.toggle input{width:18px;height:18px;accent-color:var(--purple)}.breakdown{display:grid;gap:12px;margin:20px 0}.line{display:flex;justify-content:space-between;gap:12px;color:var(--muted)}.line strong{color:var(--ink)}.line.discount strong{color:var(--green)}.grand{border-top:1px solid var(--line);padding-top:16px;margin-top:4px;font-size:25px;color:var(--purple)}.summary-note{background:#f1efff;border-radius:12px;padding:12px;color:#5142bd;font-size:13px}.action{width:100%;border:0;border-radius:13px;background:linear-gradient(100deg,var(--purple),var(--violet));color:#fff;padding:14px;font-weight:900;margin-top:14px}.secondary{background:#fff;color:var(--purple);border:1px solid #c9c3ff}.form-wrap{margin-top:24px;padding-top:24px;border-top:1px solid var(--line)}.status{min-height:22px;margin-top:10px;font-weight:700}.success{color:var(--green)}.error{color:#c43f54}.json{display:none;white-space:pre-wrap;background:#101528;color:#d8ddf0;border-radius:12px;padding:14px;font-size:12px;max-height:260px;overflow:auto}@media(max-width:900px){.shell{padding:20px 16px}.layout{grid-template-columns:1fr}.summary{position:static}.grid{grid-template-columns:1fr}.field.full{grid-column:auto}.topbar{margin-bottom:22px}}
</style></head>
<body><main class="shell">
<header class="topbar"><div class="brand">SK <span>Graphics</span></div><a href="/">Back to website</a></header>
<section class="hero"><div class="eyebrow">Custom print studio</div><h1>Build it. Price it. Print it.</h1><p>Configure premium business essentials, apparel and branding products with transparent, live pricing.</p></section>
<div class="layout"><section class="panel"><nav class="tabs" id="tabs" aria-label="Product categories"></nav><div class="config-head"><div><h2 id="productTitle"></h2><p id="productDescription"></p></div><span class="eyebrow" id="productCode"></span></div><div id="options" class="grid"></div><div class="form-wrap"><h2>Order details</h2><div class="grid"><div class="field"><label for="name">Full name</label><input id="name" required placeholder="Your name"></div><div class="field"><label for="phone">WhatsApp number</label><input id="phone" required inputmode="tel" placeholder="+91 98765 43210"></div><div class="field"><label for="email">Email</label><input id="email" type="email" placeholder="you@example.com"></div><div class="field"><label for="pincode">Pincode</label><input id="pincode" inputmode="numeric" placeholder="110001"></div><div class="field full"><label for="address">Delivery address</label><textarea id="address" rows="2" placeholder="House, street, city, state"></textarea></div><div class="field full"><label>Artwork</label><label class="upload" for="artwork"><strong>Drop artwork here or browse</strong><br>PDF, AI, PSD, CDR, PNG, JPG up to 15 MB<input id="artwork" type="file" accept=".pdf,.ai,.psd,.cdr,.png,.jpg,.jpeg"></label><div id="filePreview" class="preview"></div></div><div class="field full"><label class="toggle"><input id="designService" type="checkbox"><span>I need SK Graphics to design it for me <strong>(+₹499)</strong></span></label></div><div class="field full"><label for="remarks">Instructions</label><textarea id="remarks" rows="3" placeholder="Colours, deadlines or special requirements"></textarea></div></div></div></section>
<aside class="summary"><div class="eyebrow">Live quote</div><h2>Price breakdown</h2><div class="breakdown"><div class="line"><span>Base production</span><strong id="basePrice">₹0</strong></div><div class="line"><span>Options & add-ons</span><strong id="addons">₹0</strong></div><div class="line discount"><span id="discountLabel">Bulk discount</span><strong id="discount">-₹0</strong></div><div class="line"><span>GST (18%)</span><strong id="gst">₹0</strong></div><div class="line grand"><span>Grand total</span><strong id="total">₹0</strong></div></div><div class="summary-note" id="summaryNote">Select options to see your instant quote.</div><button class="action" id="submitOrder">Submit order / Generate WhatsApp quote</button><div id="status" class="status" aria-live="polite"></div><pre id="json" class="json"></pre></aside></div></main>
<script>
const products={
 business:{name:'Business cards',desc:'Premium visiting cards for a confident first impression.',fields:[['paper','Paper / GSM',['300 GSM Standard','350 GSM Premium Matte / Gloss','400 GSM Velvet Luxury','Textured Fine Paper']],['finish','Finish / effect',['Standard Matte / Gloss','Raised UV Spot Print','Golden Foil Stamping','Silver Foil Stamping']],['shape','Edge / shape',['Standard Square Corners','Rounded Corners (3mm)','Custom Die-Cut Shape']],['sides','Print sides',['Single Sided','Double Sided']],['quantity','Quantity',['100','250','500','1000','2500+']]]},
 tshirt:{name:'Custom t-shirts',desc:'Market-ready apparel for teams, events and brands.',fields:[['fabric','Fabric / GSM',['170 GSM Lightweight Promo','180 GSM Combed Cotton','220 GSM Heavyweight Bio-washed','240+ GSM French Terry']],['style','Style / fit',['Standard Crew Neck','Oversized Drop Shoulder','Polo Collar','Hoodie / Sweatshirt']],['method','Printing method',['DTF / Rubber Print','Screen Printing','Embroidery']],['placement','Print placement',['Front Left Chest','Front Center','Back Full','Sleeve Logo']],['quantity','Quantity',['1–5','6–25','26–100','100+']]]},
 flyers:{name:'Brochures & flyers',desc:'Sharp marketing collateral with flexible folding and stocks.',fields:[['fold','Fold type',['Single Leaf / Flyer','Bi-Fold','Tri-Fold','Z-Fold']],['paper','Paper quality',['130 GSM Glossy','170 GSM Matte','250 GSM Cardstock']],['size','Size',['A4','A5','DL Size','Square']],['quantity','Quantity',['100','500','1000','5000']]]},
 posters:{name:'Posters & banners',desc:'Large-format graphics built to get noticed.',fields:[['material','Material',['Vinyl Flex','Star Flex','Fabric Cloth Banner','Synthetic Paper']],['size','Size',['2×3 ft','3×5 ft','4×6 ft','Custom']],['finish','Finishing',['Eyelets / Grommets','Wooden Dowels','Hemmed Edges']]]},
 mugs:{name:'Custom mugs',desc:'Everyday drinkware with high-impact personalisation.',fields:[['mug','Mug type',['Classic White Ceramic','Magic Mug','Inner Color Ceramic','Clear Glass Mug','Travel Tumbler']],['print','Printing style',['Wrap-around Full Sublimation','Single Side Print']],['quantity','Quantity',['1','10','25','50','100']]]},
 stickers:{name:'Stickers & labels',desc:'Durable labels for products, packaging and promotion.',fields:[['material','Material',['Vinyl Glossy','Vinyl Matte Waterproof','Transparent Clear','Paper Sticker']],['cut','Cut type',['Die-Cut','Sheet / Kiss-Cut','Roll Labels']],['quantity','Quantity',['50','200','500','1000+']]]},
 standees:{name:'Roll-up banners',desc:'Portable display banners for events and retail spaces.',fields:[['frame','Frame quality',['Standard Aluminium Base','Premium Aluminium Cassette']],['material','Banner material',['Anti-curl Matte PVC','Premium Fabric Banner']],['size','Size',['3×6 ft','2.5×6 ft']]]},
 diaries:{name:'Diaries & notebooks',desc:'Thoughtful branded stationery for teams and clients.',fields:[['binding','Binding',['Hardbound Cover','Soft PU Leather','Spiral Wire-O']],['pages','Pages',['80 GSM Ruled','100 GSM Natural Shade','100 GSM Unruled']],['custom','Cover customisation',['Foil Stamped Logo','Full Color Wrap Cover']],['quantity','Quantity',['25','50','100','250']]]},
 folders:{name:'Presentation folders',desc:'Organise proposals and leave a polished brand impression.',fields:[['material','Material',['300 GSM Art Card','350 GSM Art Card']],['feature','Special feature',['Business Card Slit','Gusset Expansion','Velvet Soft-Touch']],['quantity','Quantity',['25','50','100','250']]]},
 canvas:{name:'Canvas printing',desc:'Gallery-quality wall art printed on premium canvas.',fields:[['frame','Framing',['Rolled Canvas','Gallery Wrapped Wooden Frame']],['size','Size',['12×18 in','18×24 in','24×36 in','Custom']],['coating','Coating',['UV Gloss Varnish','UV Matte Varnish']]]},
 boxes:{name:'Fancy boxes & packaging',desc:'Custom packaging that makes every unboxing memorable.',fields:[['style','Box style',['Rigid Magnetic Closure','Tuck-End Product Box','Drawer / Slider Gift Box','Corrugated Mailer']],['finish','Material / finish',['350 GSM SBS Matt Lamination','350 GSM SBS Gloss Lamination','Foil Stamped Branding']],['dimensions','Custom dimensions',['Small 6×6×3 in','Medium 10×8×4 in','Large 14×10×5 in']]]}
};
const categories=Object.keys(products);let category='business';let state={};const money=n=>'₹'+Math.round(n).toLocaleString('en-IN');const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function getQuantity(){const v=state.quantity||'100';return parseInt(v.replace(/\D/g,''))||1}function multiplier(){const q=getQuantity();return q>=2500?.42:q>=1000?.52:q>=500?.65:q>=250?.78:q>=100?.9:1}function price(){const p=products[category];const q=getQuantity();let base={business:2.4,tshirt:399,flyers:8,posters:450,mugs:299,stickers:4,standees:1800,diaries:380,folders:75,canvas:850,boxes:180}[category]*q;let add=0;Object.entries(state).forEach(([k,v])=>{if(k==='quantity')return;const text=String(v);if(/golden|luxury|hoodie|premium|gallery|magnetic|foil|velvet|embroidery|custom die|wooden|travel/i.test(text))add+=category==='tshirt'?120:category==='posters'?180:category==='canvas'?450:category==='boxes'?80:35});if(state.designService)add+=499;const gross=(base+add)*multiplier();const discount=(base+add)-gross;const gst=(gross)*.18;return{base,add,discount,gst,total:gross+gst}};
function renderTabs(){document.getElementById('tabs').innerHTML=categories.map(k=>`<button class="tab ${k===category?'active':''}" data-category="${k}">${products[k].name}</button>`).join('');document.querySelectorAll('[data-category]').forEach(b=>b.onclick=()=>{category=b.dataset.category;state={};render()})}
function renderOptions(){const p=products[category];document.getElementById('options').innerHTML=p.fields.map(([key,label,values])=>`<div class="field ${key==='quantity'?'full':''}"><label>${label}</label><div class="choice-row">${values.map((v,i)=>`<button type="button" class="choice ${state[key]===v||(i===0&&!state[key])?'active':''}" data-option="${key}" data-value="${esc(v)}">${v}</button>`).join('')}</div></div>`).join('')+`<div class="field full"><span class="hint">Prices update instantly as you switch material, finish and volume.</span></div>`;p.fields.forEach(([key,,values])=>{if(!state[key])state[key]=values[0]});document.querySelectorAll('[data-option]').forEach(b=>b.onclick=()=>{state[b.dataset.option]=b.dataset.value;render()})}
function renderSummary(){const x=price();document.getElementById('basePrice').textContent=money(x.base);document.getElementById('addons').textContent=money(x.add);document.getElementById('discount').textContent='-'+money(x.discount);document.getElementById('gst').textContent=money(x.gst);document.getElementById('total').textContent=money(x.total);document.getElementById('discountLabel').textContent=`Bulk discount (${Math.round(x.discount/(x.base+x.add)*100)}%)`;document.getElementById('summaryNote').textContent=`${getQuantity().toLocaleString('en-IN')} pcs · ${state.finish||state.method||'custom production'} · Free quote support available.`}
function render(){renderTabs();document.getElementById('productTitle').textContent=products[category].name;document.getElementById('productDescription').textContent=products[category].desc;document.getElementById('productCode').textContent=category.toUpperCase();renderOptions();renderSummary()}
document.getElementById('designService').onchange=e=>{state.designService=e.target.checked;renderSummary()};document.getElementById('artwork').onchange=e=>{const f=e.target.files[0];const out=document.getElementById('filePreview');if(!f)return;out.textContent=f.size>15*1024*1024?'File is larger than 15 MB. Please choose a smaller file.':`Ready: ${f.name} (${(f.size/1024/1024).toFixed(2)} MB)`;out.className='preview '+(f.size>15*1024*1024?'error':'')};
document.getElementById('submitOrder').onclick=async()=>{const status=document.getElementById('status'),x=price(),name=document.getElementById('name').value.trim(),phone=document.getElementById('phone').value.trim(),address=document.getElementById('address').value.trim();if(!name||phone.length<10||!address){status.textContent='Please add your name, valid WhatsApp number and delivery address.';status.className='status error';return}const payload={customer:{name,phone,email:document.getElementById('email').value.trim(),address:address+', Pincode: '+document.getElementById('pincode').value.trim()},items:[{name:`${products[category].name} — ${Object.values(state).filter(Boolean).join(', ')}`,price:Math.round(x.total),qty:1}],total:Math.round(x.total),deliveryFee:0,paymentMethod:'COD',paymentStatus:'pending',configuration:{category,options:state,pricing:x},remarks:document.getElementById('remarks').value.trim()};document.getElementById('json').textContent=JSON.stringify(payload,null,2);try{const r=await fetch('/api/orders',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error('Could not save order');status.textContent='Order saved. Preparing your WhatsApp quote…';status.className='status success';const text=`SK Graphics quote\n${products[category].name}\nTotal: ${money(x.total)}\nCustomer: ${name}\nPhone: ${phone}`;window.open('https://wa.me/919999999999?text='+encodeURIComponent(text),'_blank','noopener');}catch(e){status.textContent='Could not save right now. Your structured quote is ready below.';status.className='status error'}};render();
</script></body></html>
