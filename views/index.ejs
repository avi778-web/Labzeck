  function renderConfigFields(config) { const fields = config.fields.map(configFieldMarkup).join(''); const qty = `<div class="option-group"><label for="config-quantity">Quantity</label><select class="option-select config-control" id="config-quantity" data-config-key="quantity">${config.qty.map(value => `<option value="${value}">${value >= 5000 ? `${value}+` : value}</option>`).join('')}</select></div>`; const matrix = config.matrix ? `<div class="option-group"><label>Size Breakdown (optional)</label><div class="size-matrix">${['S','M','L','XL','XXL'].map(size => `<label>${size}<input class="size-input" type="number" min="0" max="999" value="0" data-size="${size}"></label>`).join('')}</div></div>` : ''; return fields + qty + matrix; }
  function renderDesignIntake(config) { return `<div class="custom-fields"><div class="option-group"><label for="config-design">Artwork / Design status</label><select class="option-select config-control" id="config-design" data-config-key="design"><option value="upload">Upload ready design</option><option value="designer">Need SK Graphics designer (+₹199)</option></select></div><div id="design-support-fields" hidden><label for="companyName">Company name &amp; slogan</label><input id="companyName" class="text-input" maxlength="160" placeholder="Company name and tagline"><label for="colorTheme">Preferred colour theme</label><input id="colorTheme" class="text-input" maxlength="80" placeholder="e.g. navy, white and gold"><label for="designInstructions">Additional instructions</label><textarea id="designInstructions" maxlength="2000" placeholder="Tell us about your design requirements"></textarea></div><label class="upload-zone" id="designUpload">Upload artwork (PDF, AI, PSD, PNG, JPG up to 50MB)<input type="file" id="designFile" accept=".pdf,.ai,.psd,image/png,image/jpeg,image/webp" onchange="readCustomizationFile('designFile','designFileData','designPreview')"></label><input type="hidden" id="designFileData"><div class="file-preview" id="designPreview"></div><label class="upload-zone" id="extraUpload">Reference logo / sample (optional)<input type="file" id="extraFile" accept=".pdf,.ai,.psd,image/png,image/jpeg,image/webp" onchange="readCustomizationFile('extraFile','extraFileData','extraPreview')"></label><input type="hidden" id="extraFileData"><div class="file-preview" id="extraPreview"></div><label for="fontStyle"><strong>Font style</strong><select id="fontStyle" class="option-select"><option>Arial</option><option>Montserrat</option><option>Poppins</option><option>Roboto</option><option>Great Vibes</option></select></label><label for="printText" style="display:block;margin-top:14px"><strong>Print instructions</strong><textarea id="printText" maxlength="2000" placeholder="Type names, phone numbers, shop name or printing instructions..."></textarea></label></div>`; }
  function openConfiguredProductOptions(name) { const config = PRODUCT_CONFIGS[name]; if (!config) return openProductOptions(name); selectedOption = { name, price: config.base, bundle: `${config.qty[0]} units`, config }; document.getElementById('optionsTitle').textContent = `${name} options`; document.getElementById('optionsBody').innerHTML = renderConfigFields(config) + renderDesignIntake(config) + '<p id="bulkSaving" class="bulk-saving" aria-live="polite"></p>'; document.getElementById('optionsBody').querySelector('[data-config-key="design"]')?.addEventListener('change', event => { document.getElementById('design-support-fields').hidden = event.target.value !== 'designer'; }); document.getElementById('optionsBody').querySelectorAll('.config-control').forEach(control => control.addEventListener('change', updateConfiguredOption)); updateConfiguredOption(); document.getElementById('optionsOverlay').classList.add('open'); syncOverlayScrollLock(); }
  function readConfiguredValues() { const config = selectedOption?.config; const values = {}; config?.fields.forEach(([key]) => { values[key] = document.getElementById(`config-${key}`)?.value || ''; }); values.quantity = Number(document.getElementById('config-quantity')?.value || config?.qty[0] || 1); values.design = document.getElementById('config-design')?.value || 'upload'; values.sizeBreakdown = {}; document.querySelectorAll('[data-size]').forEach(input => { values.sizeBreakdown[input.dataset.size] = Math.max(0, Math.min(999, Number(input.value) || 0)); }); const matrixTotal = Object.values(values.sizeBreakdown).reduce((sum, value) => sum + value, 0); if (config?.matrix && matrixTotal > 0) values.quantity = matrixTotal; return values; }
  function updateConfiguredOption() { if (!selectedOption?.config) return; const values = readConfiguredValues(); const config = selectedOption.config; let multiplier = 1; const chosen = Object.values(values).join(' ').toLowerCase(); if (chosen.includes('250 gsm') || chosen.includes('museum') || chosen.includes('luxury') || chosen.includes('metallic') || chosen.includes('gift box')) multiplier += .35; if (chosen.includes('double') || chosen.includes('both') || chosen.includes('full wrap')) multiplier += .25; if (chosen.includes('designer')) multiplier += 199 / Math.max(config.base * values.quantity, 1); const areaMatch = String(values.size || '').match(/(\d+(?:\.\d+)?)x(\d+(?:\.\d+)?)/); const areaMultiplier = nameIs('Posters & Banners') && areaMatch ? Math.max(1, Number(areaMatch[1]) * Number(areaMatch[2]) / 6) : 1; const total = Math.max(1, Math.round(config.base * values.quantity * multiplier * areaMultiplier)); selectedOption = { ...selectedOption, price: total, bundle: `${values.quantity} units`, configValues: values }; updateOptionsPrice(); const savings = values.quantity >= 1000 ? Math.round(total * .25) : values.quantity >= 500 ? Math.round(total * .15) : 0; const savingNode = document.getElementById('bulkSaving'); if (savingNode) savingNode.textContent = savings ? `Bulk saving: ₹${savings} (estimated 15–25%)` : 'Bulk discount unlocks at 500+ units'; }
  function nameIs(name) { return selectedOption?.name === name; }
  function updateOptionsPrice() { document.getElementById('optionsPrice').textContent = `₹${selectedOption?.price || 0}`; }
  function confirmConfiguredProductOption() { if (!selectedOption) return; const values = readConfiguredValues(); const designer = values.design === 'designer'; const customization = { hasDesign: !designer, addExtraAsset: Boolean(document.getElementById('extraFileData')?.value), fontStyle: document.getElementById('fontStyle')?.value || 'Arial', printText: [document.getElementById('printText')?.value, designer ? `Company: ${document.getElementById('companyName')?.value || ''}; Theme: ${document.getElementById('colorTheme')?.value || ''}; ${document.getElementById('designInstructions')?.value || ''}` : ''].filter(Boolean).join(' ').slice(0, 2000), designFile: document.getElementById('designFileData')?.value || '', extraAsset: document.getElementById('extraFileData')?.value || '', options: values }; addToCart(selectedOption.name, selectedOption.price, selectedOption.bundle, customization); closeProductOptions(); }
  function confirmProductOption() { if (selectedOption?.config) return confirmConfiguredProductOption(); if (!selectedOption) return; const customization = { hasDesign: document.getElementById('hasDesign')?.checked || false, addExtraAsset: document.getElementById('addExtraAsset')?.checked || false, fontStyle: document.getElementById('fontStyle')?.value || 'Arial', printText: document.getElementById('printText')?.value.trim() || '', designFile: document.getElementById('designFileData')?.value || '', extraAsset: document.getElementById('extraFileData')?.value || '' }; addToCart(selectedOption.name, selectedOption.price, selectedOption.bundle, customization); closeProductOptions(); }
  let verifiedPayment = null;
  let paymentInProgress = false;
  let orderSubmissionInProgress = false;
  let razorpayLoaderPromise = null;
  function resetPaymentState() {
    paymentInProgress = false;
    document.querySelectorAll('#upiPaymentPanel .btn').forEach(item => { item.disabled = false; item.classList.remove('is-loading'); });
    const button = document.getElementById('orderSubmitBtn');
    if (button) button.disabled = false;
  }
  function loadRazorpay() {
    if (window.Razorpay) return Promise.resolve(window.Razorpay);
    if (razorpayLoaderPromise) return razorpayLoaderPromise;
    razorpayLoaderPromise = new Promise((resolve, reject) => {
      const existing = document.querySelector('script[data-razorpay-checkout]');
      const script = existing || document.createElement('script');
      script.src = 'https://checkout.razorpay.com/v1/checkout.js';
      script.async = true;
      script.dataset.razorpayCheckout = 'true';
      script.onload = () => window.Razorpay ? resolve(window.Razorpay) : reject(new Error('Payment checkout did not load.'));
      script.onerror = () => reject(new Error('Secure payment could not load. Check your connection and try again.'));
      if (!existing) document.head.appendChild(script);
    });
    return razorpayLoaderPromise;
  }
  function getCartSubtotal() { return cart.reduce((sum, item) => sum + item.price * item.qty, 0); }
 function getCartTotal() { return Math.max(0, getCartSubtotal() - (couponApplied?.discountAmount || 0)); }
 function updateCheckoutTotals() { const subtotal = getCartSubtotal(); document.getElementById('checkoutSubtotal')?.replaceChildren(document.createTextNode(`₹${subtotal}`)); document.getElementById('checkoutTotal')?.replaceChildren(document.createTextNode(`₹${getCartTotal()}`)); }
 async function applyCoupon() { const input = document.getElementById('couponCode'); const message = document.getElementById('couponMessage'); const code = input?.value.trim(); if (!code) return; const button = document.getElementById('applyCouponBtn'); button.disabled = true; try { const response = await fetch('/api/coupons/validate', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ code, subtotal: getCartSubtotal() }) }); const result = await parseResponse(response); if (!response.ok) throw new Error('Invalid or Expired Coupon Code'); couponApplied = { code, discountAmount: result.discountAmount }; message.textContent = `Coupon applied: ₹${result.discountAmount} OFF · Free Delivery`; message.className = 'coupon-message success'; input.readOnly = true; button.textContent = 'Applied'; updateCheckoutTotals(); } catch (_) { couponApplied = null; message.textContent = 'Invalid or Expired Coupon Code'; message.className = 'coupon-message error'; updateCheckoutTotals(); } finally { button.disabled = false; } }
  function updatePaymentPanel() { const isUpi = document.getElementById('paymentMethod').value === 'UPI'; document.getElementById('upiPaymentPanel').hidden = !isUpi; if (!isUpi) { verifiedPayment = null; resetPaymentState(); } }
  function updateFirstOrderBadge() {
    const badge = document.getElementById('firstOrderBadge');
    if (!badge) return;
    try { badge.hidden = localStorage.getItem('sk_graphics_order_completed') === 'true'; } catch (_) { badge.hidden = false; }
  }
  async function startRazorpayPayment(preferredMethod = 'upi') { if (paymentInProgress) return; if (!cart.length) return alert('Add a product before starting payment.'); paymentInProgress = true; const buttons = [...document.querySelectorAll('#upiPaymentPanel .btn')]; buttons.forEach(button => { button.disabled = true; button.classList.add('is-loading'); }); const button = document.getElementById('orderSubmitBtn'); button.disabled = true; try { await loadRazorpay(); const response = await fetch('/api/create-order', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ amount: Math.round(getCartTotal() * 100), items: cart.map(item => ({ name:item.name, price:item.price, qty:item.qty })), couponCode: couponApplied?.code, idempotencyKey: orderToken }) }); const order = await parseResponse(response); if (!response.ok) throw new Error(order.message || 'Unable to start payment'); const razorpay = new Razorpay({ key: order.keyId, amount: order.amount, currency: order.currency, name:'SK Graphics', description:'SK Graphics order', order_id:order.orderId, config: preferredMethod === 'qr' ? { display: { blocks: { upi: { name: 'Scan QR with any UPI app', instruments: [{ method: 'upi' }] } }, sequence: ['block.upi'], preferences: { show_default_blocks: false } } } : undefined, handler: async function (payment) { try { const verified = await fetch('/api/payments/verify', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payment) }); const result = await parseResponse(verified); if (!verified.ok || !result.confirmed) throw new Error(result.message || 'Payment verification failed'); verifiedPayment = { paymentStatus:'paid', transactionId:payment.razorpay_payment_id, razorpayOrderId:payment.razorpay_order_id }; resetPaymentState(); document.getElementById('orderForm').requestSubmit(); } catch (error) { paymentInProgress=false; buttons.forEach(item => { item.disabled=false; item.classList.remove('is-loading'); }); button.disabled=false; alert(error.message || 'Payment verification failed.'); } }, modal:{ ondismiss:()=>{ paymentInProgress=false; buttons.forEach(item => { item.disabled=false; item.classList.remove('is-loading'); }); button.disabled=false; } }, prefill:{ name:document.getElementById('custName').value, contact:document.getElementById('custPhone').value } }); razorpay.open(); } catch (error) { paymentInProgress=false; buttons.forEach(item => { item.disabled=false; item.classList.remove('is-loading'); }); button.disabled=false; alert(error.message || 'Payment could not be started.'); } }
  function launchUPIPayment() { startRazorpayPayment(); }
  function showUPIQR() {
    if (!cart.length) return alert('Add a product before opening the payment QR.');
    startRazorpayPayment('qr');
  }
  function closeUPIQR() { document.getElementById('qrOverlay').classList.remove('open'); }
  async function submitOrder(e) {
    e.preventDefault();
    const name = document.getElementById('custName').value.trim();
    const phone = document.getElementById('custPhone').value.trim();
    const address = document.getElementById('custAddress').value.trim();
    const notes = document.getElementById('custNotes').value.trim();
    const paymentMethod = document.getElementById('paymentMethod').value;
    const total = getCartTotal();
    if (!cart.length || !name || !phone || !address) return alert('Please complete your order details and add a product.');
    if (paymentMethod === 'UPI' && !verifiedPayment) { await startRazorpayPayment(); return; }
    if (orderSubmissionInProgress) return;
    orderSubmissionInProgress = true;
    let location = null;
    if (navigator.geolocation) { try { const position = await new Promise((resolve, reject) => navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 5000 })); location = { latitude: position.coords.latitude, longitude: position.coords.longitude }; } catch (_) { console.warn('Location permission unavailable; saving address only.'); } }
    const button = document.getElementById('orderSubmitBtn'); button.disabled = true; button.textContent = 'Saving order...';
    try {
      const response = await fetch('/api/orders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ customer: { name, phone, address, location }, items: cart, subtotal: getCartSubtotal(), total, couponCode: couponApplied?.code, couponApplied, notes: `${notes}${notes ? ' | ' : ''}Payment: ${paymentMethod}`,  paymentMethod, paymentStatus: verifiedPayment?.paymentStatus || (paymentMethod === 'COD' ? 'cod' : 'pending'), transactionId: verifiedPayment?.transactionId || '', razorpayOrderId: verifiedPayment?.razorpayOrderId || '', deliveryFee: 0, idempotencyKey: orderToken }) });
      const result = await parseResponse(response); if (!response.ok) throw new Error(result.message || 'Could not save order');
      alert(`Order saved successfully. Order ID: ${result.orderId}`); const itemsList = cart.map(item => `${item.name} (Qty: ${item.qty}) - ₹${item.price * item.qty}${item.customization ? ` | Font: ${item.customization.fontStyle || 'Arial'} | Print text: ${item.customization.printText || 'None'} | Design upload: ${item.customization.hasDesign ? 'Yes' : 'No'} | Extra logo/photo: ${item.customization.addExtraAsset ? 'Yes' : 'No'}${item.customization.designFile ? ` | Design: ${window.location.origin}${item.customization.designFile}` : ''}${item.customization.extraAsset ? ` | Extra: ${window.location.origin}${item.customization.extraAsset}` : ''}` : ''}`).join('\\n'); const message = `*ORDER - SK GRAPHICS*\\n*Customer:* ${name}\\n*Phone:* ${phone}\\n*Address:* ${address}\\n*Items:*\\n${itemsList}\\n*Subtotal:* ₹${getCartSubtotal()}\\n*Coupon:* ${couponApplied ? `₹${couponApplied.discountAmount} OFF (${couponApplied.code})` : 'None'}\\n*Delivery:* FREE\\n*Total:* ₹${total}\\n*Payment:* ${paymentMethod}\\n*Notes:* ${notes || 'None'}`; window.open(`https://wa.me/918447459316?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer'); cart = []; couponApplied = null; verifiedPayment = null; orderToken = createOrderToken(); try { localStorage.setItem('sk_graphics_order_completed', 'true'); } catch (_) {} updateCartUI(); closeOrderModal(); document.getElementById('orderForm').reset(); updatePaymentPanel(); updateFirstOrderBadge();
    } catch (error) { alert(error.message || 'Could not save order. Please try again.'); }
    finally { orderSubmissionInProgress = false; button.disabled = false; button.textContent = 'Submit Order'; }
  }

  initProductSearch();
  updateFirstOrderBadge();

