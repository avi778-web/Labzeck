  if (type === 'note') return '<p class="form-note">' + field[3] + '</p>';
  return '<div class="form-group"><label>' + label + '</label>' + (type === 'textarea' ? '<textarea name="' + id + '" rows="2"></textarea>' : '<input type="text" name="' + id + '">') + '</div>';
}
