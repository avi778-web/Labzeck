let curSlide = 0, totalSlides = 1, autoTimer;
function updateSlider() {
  document.getElementById('sliderTrack').style.transform = 'translateX(-' + (curSlide * 100) + '%)';
  document.querySelectorAll('.sl-dot').forEach((d,i) => d.classList.toggle('act', i===curSlide));
}
function changeSlide(d) { curSlide = (curSlide + d + totalSlides) % totalSlides; updateSlider(); resetAuto(); }
function goSlide(n)      { curSlide = n; updateSlider(); resetAuto(); }
function startAuto()     { clearInterval(autoTimer); }
function resetAuto()     { clearInterval(autoTimer); startAuto(); }
startAuto();

