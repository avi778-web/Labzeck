<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SK Graphics | Online Printing Services | Delhi, Noida, India</title>
  <meta name="description" content="SK Graphics is a one-stop print shop in Delhi-India. We print business cards, flyers, brochures, stickers, boxes, folders, notebooks and more.">
  <meta name="keywords" content="Online printing India, business card, flyers printing, brochures, letterheads, fancy boxes, folders, notebooks, canvas, custom mugs, t-shirts, Stickers, Envelopes, pillow printing, rollup printing India">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* ============================================================
       RESET & BASE
    ============================================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }
    body { font-family: 'Raleway', 'Open Sans', sans-serif; color: #333; background: #fff; overflow-x: hidden; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; height: auto; display: block; }
    ul { list-style: none; }

    /* ============================================================
       VARIABLES
    ============================================================ */
    :root {
      --primary:      #2b76a6;
      --primary-dark: #1e5580;
      --accent:       #f57c1f;
      --accent-dark:  #d96a0e;
      --text:         #2c2c2c;
      --text-light:   #666;
      --text-muted:   #999;
      --bg-light:     #f8f9fa;
      --border:       #e0e4e8;
      --radius:       6px;
      --radius-lg:    12px;
      --shadow:       0 2px 15px rgba(0,0,0,.08);
      --shadow-hov:   0 8px 30px rgba(43,118,166,.18);
      --wp-green:     #25d366;
    }

    /* ============================================================
       UTILITY
    ============================================================ */
    .container      { max-width: 1240px; margin: 0 auto; padding: 0 20px; }
    .container-fluid{ width: 100%; padding: 0 24px; }
    .section-pad    { padding: 70px 0; }
    .text-center    { text-align: center; }
    .d-flex         { display: flex; }
    .align-center   { align-items: center; }
    .gap-8  { gap: 8px; }
    .gap-12 { gap: 12px; }
    .gap-20 { gap: 20px; }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 7px;
      padding: 11px 26px; border-radius: var(--radius); font-weight: 700;
      font-size: 14px; cursor: pointer; transition: all .25s ease;
      border: 2px solid transparent; letter-spacing: .3px; font-family: inherit;
      white-space: nowrap;
    }
    .btn-primary  { background: var(--primary);  color: #fff; border-color: var(--primary); }
    .btn-primary:hover  { background: var(--primary-dark); border-color: var(--primary-dark); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(43,118,166,.35); }
    .btn-accent   { background: var(--accent);   color: #fff; border-color: var(--accent); }
    .btn-accent:hover   { background: var(--accent-dark);  border-color: var(--accent-dark);  transform: translateY(-1px); box-shadow: 0 4px 14px rgba(245,124,31,.35); }
    .btn-white    { background: #fff; color: var(--primary); border-color: #fff; }
    .btn-white:hover    { background: #f0f7ff; }
    .btn-outline-white  { background: transparent; color: #fff; border-color: rgba(255,255,255,.7); }
    .btn-outline-white:hover { background: rgba(255,255,255,.15); }
    .btn-wp { background: var(--wp-green); color: #fff; border-color: var(--wp-green); font-size: 15px; padding: 12px 28px; }
    .btn-wp:hover { background: #1fba57; transform: translateY(-1px); box-shadow: 0 4px 14px rgba(37,211,102,.4); }

    /* Section headings */
    .section-tag {
      display: inline-block; background: rgba(43,118,166,.1); color: var(--primary);
      font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;
      padding: 5px 14px; border-radius: 20px; margin-bottom: 12px;
    }
    .section-title    { font-size: 28px; font-weight: 800; color: var(--text); margin-bottom: 10px; line-height: 1.25; }
    .section-subtitle { font-size: 15px; color: var(--text-light); margin-bottom: 40px; line-height: 1.6; }
    .section-header   { text-align: center; }

    /* ============================================================
       ANNOUNCEMENT BAR
    ============================================================ */
    .ann-bar {
      background: #1a2a3a; color: #fff; text-align: center;
      padding: 9px 20px; font-size: 13px; font-weight: 500;
      display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
    }
    .ann-bar a { color: #ffd166; font-weight: 700; }
    .ann-bar strong { color: #ffd166; }

    /* ============================================================
       TOP BAR
    ============================================================ */
    .top-bar {
      background: #fff; border-bottom: 1px solid var(--border);
      padding: 7px 0; font-size: 13px;
    }
    .top-bar-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
    .top-contact   { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
    .top-contact p { margin: 0; display: flex; align-items: center; gap: 7px; color: var(--text-light); }
    .top-contact a { color: var(--text); font-weight: 700; }
    .top-contact a:hover { color: var(--primary); }
    .top-contact i { color: var(--primary); }
    .top-links { display: flex; align-items: center; gap: 4px; }
    .top-links a {
      color: var(--text-light); font-size: 13px; font-weight: 500;
      padding: 5px 11px; border-radius: 4px; transition: all .2s;
    }
    .top-links a:hover { background: var(--bg-light); color: var(--primary); }
    .top-links .tl-quote {
      background: var(--accent); color: #fff; font-weight: 700;
      padding: 5px 14px; border-radius: 4px;
    }
    .top-links .tl-quote:hover { background: var(--accent-dark); }

    /* ============================================================
       HEADER
    ============================================================ */
    .main-header {
      background: #fff; border-bottom: 2px solid var(--border);
      position: sticky; top: 0; z-index: 1000;
      box-shadow: 0 2px 12px rgba(0,0,0,.07);
    }
    .hdr-inner {
      display: flex; align-items: center; gap: 18px;
      padding: 12px 24px; max-width: 1340px; margin: 0 auto;
    }

    /* LOGO */
    .sk-logo {
      display: flex; flex-direction: column; line-height: 1;
      text-decoration: none; flex-shrink: 0;
    }
    .sk-logo .sk-name {
      font-size: 24px; font-weight: 800; color: var(--primary);
      letter-spacing: -.5px; white-space: nowrap;
    }
    .sk-logo .sk-sub {
      font-size: 10.5px; color: var(--accent); font-weight: 700;
      letter-spacing: 1.2px; text-transform: uppercase; white-space: nowrap;
    }
    .sk-logo-img { width: 92px; height: 38px; object-fit: contain; object-position: left center; margin-top: 4px; }
    .f-logo-img { width: 150px; height: 78px; object-fit: contain; object-position: left center; margin-bottom: 10px; }

    /* NAV */
    .main-nav { display: flex; align-items: center; gap: 2px; flex: 1; }
    .ni { position: relative; }
    .ni > a {
      display: flex; align-items: center; gap: 4px; padding: 10px 13px;
      font-size: 13.5px; font-weight: 700; color: var(--text); border-radius: 5px;
      transition: all .2s; white-space: nowrap;
    }
    .ni > a i { font-size: 10px; transition: transform .2s; }
    .ni > a:hover, .ni:hover > a { color: var(--primary); background: rgba(43,118,166,.07); }
    .ni:hover > a i { transform: rotate(180deg); }

    /* MEGA MENU */
    .mega-dd {
      display: none; position: absolute; top: 100%; left: 0;
      background: #fff; border: 1px solid var(--border);
      border-radius: var(--radius); box-shadow: 0 10px 40px rgba(0,0,0,.13);
      min-width: 780px; z-index: 9999; overflow: hidden;
    }
    .ni:hover .mega-dd { display: flex; }
    .mega-left { width: 220px; background: var(--bg-light); border-right: 1px solid var(--border); flex-shrink: 0; }
    .mega-left li a {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 20px; font-size: 13px; font-weight: 700; color: var(--text); transition: all .2s;
    }
    .mega-left li a:hover, .mega-left li.act a {
      background: #fff; color: var(--primary); border-right: 3px solid var(--primary);
    }
    .mega-right { flex: 1; padding: 22px 26px; min-width: 0; }
    .sub-panel { display: none; }
    .sub-panel.act { display: block; }
    .sub-panel h6 { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--primary); margin-bottom: 14px; font-weight: 800; }
    .prod-links { display: grid; grid-template-columns: 1fr 1fr; gap: 3px 20px; }
    .prod-links a {
      display: block; padding: 7px 10px; font-size: 13px; color: var(--text-light);
      border-radius: 4px; transition: all .2s; font-weight: 500;
    }
    .prod-links a:hover { background: rgba(43,118,166,.08); color: var(--primary); padding-left: 16px; }

    /* SIMPLE DROPDOWN */
    .simple-dd {
      display: none; position: absolute; top: 100%; left: 0;
      background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: 0 8px 28px rgba(0,0,0,.1); min-width: 190px; z-index: 9999; padding: 6px 0;
    }
    .ni:hover .simple-dd { display: block; }
    .simple-dd a { display: block; padding: 9px 18px; font-size: 13.5px; color: var(--text); transition: all .2s; }
    .simple-dd a:hover { background: var(--bg-light); color: var(--primary); }

    /* SEARCH */
    .hdr-search { position: relative; flex: 1; max-width: 310px; }
    .hdr-search input {
      width: 100%; padding: 9px 42px 9px 16px;
      border: 1.5px solid var(--border); border-radius: 25px;
      font-size: 13.5px; outline: none; font-family: inherit;
      transition: border-color .2s; color: var(--text);
    }
    .hdr-search input:focus { border-color: var(--primary); }
    .hdr-search button {
      position: absolute; right: 0; top: 0; height: 100%; padding: 0 14px;
      background: var(--primary); border: none; border-radius: 0 25px 25px 0;
      color: #fff; cursor: pointer; transition: background .2s;
    }
    .hdr-search button:hover { background: var(--primary-dark); }

    /* HEADER ICONS */
    .hdr-icons { display: flex; align-items: center; gap: 4px; }
    .hdr-icon-btn {
      display: flex; align-items: center; gap: 5px; padding: 8px 11px;
      border-radius: 7px; font-size: 13px; color: var(--text);
      transition: all .2s; cursor: pointer; background: none; border: none;
      font-family: inherit; position: relative;
    }
    .hdr-icon-btn i { font-size: 18px; }
    .hdr-icon-btn:hover { background: var(--bg-light); color: var(--primary); }
    .hdr-icon-btn .badge {
      position: absolute; top: 4px; right: 4px;
      background: var(--accent); color: #fff;
      border-radius: 50%; width: 17px; height: 17px;
      font-size: 10px; display: flex; align-items: center; justify-content: center;
      font-weight: 800; line-height: 1;
    }
    .hdr-icon-btn .label-text { font-size: 12px; font-weight: 600; }

    /* MOBILE TOGGLE */
    .mob-toggle {
      display: none; background: none; border: 1.5px solid var(--border);
      border-radius: 6px; cursor: pointer; padding: 7px 9px;
      flex-direction: column; gap: 5px; flex-shrink: 0;
    }
    .mob-toggle span { display: block; width: 22px; height: 2px; background: var(--text); border-radius: 2px; transition: all .3s; }

    /* ============================================================
       HERO SLIDER
    ============================================================ */
    .hero { position: relative; overflow: hidden; }
    .slider-track { display: flex; transition: transform .65s cubic-bezier(.25,.46,.45,.94); will-change: transform; }
    .slide {
      min-width: 100%; position: relative; display: flex; align-items: center;
      min-height: 490px; overflow: hidden;
    }
    .slide-1 { background: linear-gradient(135deg, #1a4b6e 0%, #2b76a6 55%, #3a9bd5 100%); }
    .slide-2 { background: linear-gradient(135deg, #2d4a22 0%, #4a7c35 55%, #6aab45 100%); }
    .slide-3 { background: linear-gradient(135deg, #5a1e82 0%, #8b2fc9 55%, #b55de3 100%); }
    .slide-deco  { position: absolute; right: -80px; top: -80px; width: 480px; height: 480px; border-radius: 50%; background: rgba(255,255,255,.06); pointer-events: none; }
    .slide-deco2 { position: absolute; right: 60px; bottom: -120px; width: 280px; height: 280px; border-radius: 50%; background: rgba(255,255,255,.05); pointer-events: none; }
    .slide-content { position: relative; z-index: 2; padding: 60px 70px; max-width: 620px; }
    .slide-visual {
      position: absolute; z-index: 1; right: 5%; width: 42%; max-width: 560px;
      height: 76%; border-radius: 18px; overflow: hidden;
      box-shadow: 0 18px 45px rgba(0,0,0,.24); transform: rotate(2deg);
    }
    .slide-visual img { width: 100%; height: 100%; object-fit: cover; }
    .slide-visual::after {
      content: 'SK Graphics'; position: absolute; right: 16px; bottom: 14px;
      padding: 6px 10px; border-radius: 5px; background: rgba(255,255,255,.92);
      color: var(--primary-dark); font-size: 11px; font-weight: 800;
    }
    .slide-label {
      display: inline-block; background: rgba(255,255,255,.2); color: #fff;
      font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px;
      padding: 5px 14px; border-radius: 20px; margin-bottom: 20px;
    }
    .slide-title { font-size: 42px; font-weight: 800; color: #fff; line-height: 1.18; margin-bottom: 16px; }
    .slide-title .hi { color: #ffd166; }
    .slide-desc { font-size: 16px; color: rgba(255,255,255,.88); margin-bottom: 32px; line-height: 1.65; }
    .slide-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .hero-single .slider-track { transform: none !important; }
    .hero-single .slide-2, .hero-single .slide-3,
    .hero-single .sl-prev, .hero-single .sl-next,
    .hero-single .sl-dots { display: none; }
    .hero-single .slide-1 {
      min-height: 0; height: clamp(300px, 34.25vw, 490px);
      background: #2b76a6;
    }
    .single-hero-image {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; object-position: center; display: block;
    }
    .hero-single .slide-1 .slide-content,
    .hero-single .slide-1 .slide-visual,
    .hero-single .slide-1 .slide-deco,
    .hero-single .slide-1 .slide-deco2 { display: none; }
    @media (max-width: 900px) {
      .slide-visual { right: 3%; width: 38%; height: 58%; opacity: .35; }
      .slide-content { max-width: 700px; }
    }
    @media (max-width: 600px) { .slide-visual { display: none; } }

    /* Slider Controls */
    .sl-prev, .sl-next {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
      background: rgba(255,255,255,.2); border: 2px solid rgba(255,255,255,.5);
      color: #fff; width: 46px; height: 46px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all .2s; backdrop-filter: blur(4px);
    }
    .sl-prev { left: 18px; } .sl-next { right: 18px; }
    .sl-prev:hover, .sl-next:hover { background: rgba(255,255,255,.35); }
    .sl-dots { position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; z-index: 10; }
    .sl-dot {
      width: 9px; height: 9px; border-radius: 50%; background: rgba(255,255,255,.45);
      cursor: pointer; transition: all .25s; border: none;
    }
    .sl-dot.act { background: #fff; width: 26px; border-radius: 5px; }

    /* ============================================================
       FEATURES BAR
    ============================================================ */
    .feat-bar { background: var(--primary); }
    .feat-bar-inner { display: flex; align-items: stretch; flex-wrap: wrap; }
    .feat-item {
      flex: 1; min-width: 180px; display: flex; align-items: center; gap: 14px;
      padding: 18px 22px; color: #fff; border-right: 1px solid rgba(255,255,255,.15);
      transition: background .2s;
    }
    .feat-item:last-child { border-right: none; }
    .feat-item:hover { background: rgba(255,255,255,.1); }
    .feat-item i { font-size: 24px; opacity: .9; flex-shrink: 0; }
    .feat-item h6 { font-size: 13.5px; font-weight: 700; margin-bottom: 2px; }
    .feat-item p { font-size: 12px; opacity: .8; margin: 0; }

    /* ============================================================
       CATEGORIES
    ============================================================ */
    .cats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
      gap: 20px;
    }
    .cat-card {
      border: 1.5px solid var(--border); border-radius: var(--radius-lg);
      overflow: hidden; transition: all .3s ease; cursor: pointer; background: #fff;
    }
    .cat-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-hov); border-color: var(--primary); }
    .cat-img {
      height: 165px; display: flex; align-items: center; justify-content: center;
      overflow: hidden; position: relative;
    }
    .cat-img img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform .35s ease, filter .35s ease;
    }
    .cat-card:hover .cat-img img { transform: scale(1.06); filter: saturate(1.08); }
    .cat-img::after {
      content: ''; position: absolute; right: 10px; bottom: 10px; width: 52px; height: 52px;
      border-radius: 50%; background: #070707 url('sk-graphics-logo.png') center / 122% auto no-repeat;
      box-shadow: 0 2px 8px rgba(0,0,0,.24); opacity: .96;
    }
    .cat-img .ci { font-size: 50px; opacity: .55; }
    .ci-blue   { color: #1565c0; } .ci-green  { color: #2e7d32; }
    .ci-orange { color: #e65100; } .ci-purple { color: #6a1b9a; }
    .ci-teal   { color: #00695c; } .ci-red    { color: #b71c1c; }
    .ci-lime   { color: #558b2f; } .ci-amber  { color: #f57f17; }
    .ci-indigo { color: #283593; } .ci-brown  { color: #4e342e; }
    .ci-cyan   { color: #00838f; } .ci-yellow { color: #f9a825; }
    .cat-body { padding: 15px 17px 17px; }
    .cat-body h5 { font-size: 15px; font-weight: 700; margin-bottom: 6px; color: var(--text); }
    .cat-body p { font-size: 12.5px; color: var(--text-light); margin-bottom: 12px; line-height: 1.55; }
    .cat-body .cat-link {
      font-size: 13px; font-weight: 700; color: var(--primary);
      display: flex; align-items: center; gap: 5px; transition: gap .2s;
    }
    .cat-body .cat-link:hover { gap: 10px; }

    /* BG colours for category tiles */
    .bg-c1 { background: linear-gradient(135deg,#e3f2fd,#bbdefb); }
    .bg-c2 { background: linear-gradient(135deg,#fff3e0,#ffe0b2); }
    .bg-c3 { background: linear-gradient(135deg,#e8f5e9,#c8e6c9); }
    .bg-c4 { background: linear-gradient(135deg,#f3e5f5,#e1bee7); }
    .bg-c5 { background: linear-gradient(135deg,#e0f7fa,#b2ebf2); }
    .bg-c6 { background: linear-gradient(135deg,#fce4ec,#f8bbd0); }
    .bg-c7 { background: linear-gradient(135deg,#f1f8e9,#dcedc8); }
    .bg-c8 { background: linear-gradient(135deg,#fff8e1,#ffecb3); }
    .bg-c9 { background: linear-gradient(135deg,#e8eaf6,#c5cae9); }
    .bg-c10{ background: linear-gradient(135deg,#efebe9,#d7ccc8); }
    .bg-c11{ background: linear-gradient(135deg,#e0f2f1,#b2dfdb); }
    .bg-c12{ background: linear-gradient(135deg,#fff9c4,#fff59d); }

    /* ============================================================
       PROMO STRIP
    ============================================================ */
    .promo-strip { background: linear-gradient(90deg,#f57c1f,#ff9a3c); padding: 22px 0; }
    .promo-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    .promo-text h4 { font-size: 20px; font-weight: 800; color: #fff; margin-bottom: 4px; }
    .promo-text p  { font-size: 14px; opacity: .92; color: #fff; margin: 0; }
    .promo-btns { display: flex; gap: 12px; flex-wrap: wrap; }

    /* ============================================================
       HOW IT WORKS - INTERACTIVE PROCESS
    ============================================================ */
    .how-works { padding: 78px 0; background: linear-gradient(180deg,#f8fbff 0%,#eef5fb 100%); }
    .process-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 18px; align-items: stretch; }
    .process-card {
      position: relative; display: flex; flex-direction: column; min-width: 0;
      padding: 24px; border: 1px solid rgba(255,255,255,.9); border-radius: 20px;
      background: rgba(255,255,255,.78); box-shadow: 0 12px 34px rgba(35,75,110,.1);
      backdrop-filter: blur(14px); transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .process-card:hover { transform: translateY(-6px); box-shadow: 0 18px 42px rgba(35,75,110,.16); border-color: rgba(43,118,166,.35); }
    .process-card-head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
    .process-badge { width: 40px; height: 40px; flex: 0 0 40px; display: grid; place-items: center; border-radius: 13px; color: #fff; font-size: 16px; font-weight: 800; }
    .process-card:nth-child(1) .process-badge { background: linear-gradient(135deg,#2b76a6,#36a4d8); }
    .process-card:nth-child(2) .process-badge { background: linear-gradient(135deg,#7b4fd1,#a66df0); }
    .process-card:nth-child(3) .process-badge { background: linear-gradient(135deg,#e77927,#f5aa38); }
    .process-card:nth-child(4) .process-badge { background: linear-gradient(135deg,#159b70,#42c58d); }
    .process-icon { width: 22px; height: 22px; color: var(--primary); stroke-width: 2; }
    .process-card:nth-child(2) .process-icon { color: #7b4fd1; }
    .process-card:nth-child(3) .process-icon { color: #df7625; }
    .process-card:nth-child(4) .process-icon { color: #159b70; }
    .process-card h5 { font-size: 17px; font-weight: 800; color: var(--text); margin: 0; line-height: 1.25; }
    .process-card > p { color: var(--text-light); font-size: 13px; line-height: 1.6; margin: 0 0 18px; }
    .process-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin-top: auto; }
    .process-field { display: flex; flex-direction: column; gap: 5px; }
    .process-field label { color: var(--text-muted); font-size: 10px; font-weight: 800; letter-spacing: .7px; text-transform: uppercase; }
    .process-field select { width: 100%; padding: 9px 26px 9px 10px; border: 1px solid var(--border); border-radius: 9px; color: var(--text); background: #fff; font: 600 12px inherit; outline: none; }
    .process-field select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(43,118,166,.12); }
    .drop-zone { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 125px; padding: 15px; border: 1.5px dashed #bca8ec; border-radius: 13px; background: linear-gradient(135deg,rgba(123,79,209,.06),rgba(255,255,255,.7)); text-align: center; cursor: pointer; transition: all .2s ease; }
    .drop-zone:hover, .drop-zone.is-dragover { border-color: #7b4fd1; background: rgba(123,79,209,.12); }
    .drop-zone svg { width: 27px; height: 27px; color: #7b4fd1; margin-bottom: 6px; }
    .drop-zone strong { color: var(--text); font-size: 12px; }
    .drop-zone span { color: var(--text-muted); font-size: 11px; margin-top: 4px; }
    .file-preview { display: none; align-items: center; gap: 9px; margin-top: 10px; padding: 9px 10px; border-radius: 9px; background: #f1edff; color: #5d3e9e; font-size: 11px; }
    .file-preview.show { display: flex; }
    .file-preview svg { width: 17px; height: 17px; flex: 0 0 17px; }
    .file-status { margin-left: auto; color: #159b70; font-weight: 800; }
    .design-help { width: 100%; margin-top: 11px; padding: 9px 12px; border: 1px solid #d7c9f6; border-radius: 9px; background: #fff; color: #6a46b4; font: 700 12px inherit; cursor: pointer; transition: background .2s; }
    .design-help:hover { background: #f1edff; }
    .proof-card { padding: 13px; border-radius: 12px; background: #fff; border: 1px solid #f0dfc7; }
    .proof-head { display: flex; align-items: center; gap: 9px; padding-bottom: 10px; border-bottom: 1px solid #f1eee8; }
    .proof-head svg { width: 23px; height: 23px; color: #df7625; }
    .proof-head strong { font-size: 12px; color: var(--text); }
    .proof-head small { display: block; color: var(--text-muted); font-size: 10px; margin-top: 2px; }
    .check-list { display: grid; gap: 8px; padding: 12px 0; }
    .check-row { display: flex; align-items: center; justify-content: space-between; color: var(--text-light); font-size: 12px; }
    .check-row span:last-child { display: inline-flex; align-items: center; gap: 4px; color: #159b70; font-size: 11px; font-weight: 800; }
    .check-row svg { width: 15px; height: 15px; }
    .approve-btn { width: 100%; padding: 10px 12px; border: 0; border-radius: 9px; background: #df7625; color: #fff; font: 800 12px inherit; cursor: pointer; transition: filter .2s, transform .2s; }
    .approve-btn:hover { filter: brightness(.95); transform: translateY(-1px); }
    .approve-btn.approved { background: #159b70; }
    .delivery-badge { display: inline-flex; align-items: center; gap: 7px; width: fit-content; padding: 7px 10px; border-radius: 999px; background: #e5f8f0; color: #127b5b; font-size: 11px; font-weight: 800; margin-bottom: 17px; }
    .delivery-badge svg { width: 15px; height: 15px; }
    .tracking { display: grid; gap: 13px; margin-top: auto; }
    .track-row { display: flex; align-items: center; gap: 9px; color: var(--text-light); font-size: 11px; }
    .track-dot { width: 12px; height: 12px; flex: 0 0 12px; border-radius: 50%; background: #159b70; box-shadow: 0 0 0 4px #dcf5eb; }
    .track-dot.pending { background: #c5d0d8; box-shadow: 0 0 0 4px #edf1f3; }
    .track-line { width: 1px; height: 12px; margin-left: 5px; margin-top: -13px; background: #bce8d5; }
    .legacy-how-works { padding: 70px 0; background: var(--bg-light); }
    .legacy-how-works .steps-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 30px; position: relative; }
    .legacy-how-works .step-card { text-align: center; position: relative; z-index: 1; }
    .legacy-how-works .step-num { width: 54px; height: 54px; background: var(--primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; margin: 0 auto 18px; border: 4px solid #fff; box-shadow: 0 4px 14px rgba(43,118,166,.3); }
    .legacy-how-works .step-card h5 { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
    .legacy-how-works .step-card p { font-size: 13px; color: var(--text-light); line-height: 1.65; }

    /* ============================================================
       WHY CHOOSE US
    ============================================================ */
    .why-us { padding: 70px 0; background: var(--bg-light); }
    .why-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
    .why-left-mini { display: flex; gap: 28px; flex-wrap: wrap; margin-bottom: 28px; }
    .why-mini-stat { text-align: center; }
    .why-mini-stat .num { font-size: 32px; font-weight: 800; color: var(--primary); line-height: 1; }
    .why-mini-stat .lbl { font-size: 13px; color: var(--text-muted); margin-top: 2px; }
    .why-desc { font-size: 14.5px; color: var(--text-light); line-height: 1.8; margin-bottom: 24px; }
    .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .why-card {
      background: #fff; border-radius: var(--radius-lg); padding: 22px;
      display: flex; gap: 16px; border: 1.5px solid var(--border); transition: all .3s;
    }
    .why-card:hover { box-shadow: var(--shadow-hov); border-color: var(--primary); transform: translateY(-3px); }
    .why-icon {
      width: 50px; height: 50px; background: rgba(43,118,166,.1);
      border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .why-icon i { font-size: 20px; color: var(--primary); }
    .why-con h5 { font-size: 14px; font-weight: 700; margin-bottom: 5px; }
    .why-con p  { font-size: 13px; color: var(--text-light); line-height: 1.6; }

    /* ============================================================
       STATS
    ============================================================ */
    .stats-sec { padding: 58px 0; background: var(--primary); }
    .stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 30px; }
    .stat-item { text-align: center; color: #fff; }
    .stat-num { font-size: 44px; font-weight: 800; line-height: 1; margin-bottom: 8px; }
    .stat-num sup { font-size: 22px; }
    .stat-lbl { font-size: 14px; opacity: .85; font-weight: 500; }

    /* ============================================================
       TESTIMONIALS
    ============================================================ */
    .testi-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; }
    .testi-card {
      background: var(--bg-light); border-radius: var(--radius-lg);
      padding: 26px; border: 1.5px solid var(--border); transition: all .3s; position: relative;
    }
    .testi-card::before {
      content: '"'; position: absolute; top: 14px; right: 22px;
      font-size: 72px; color: var(--primary); opacity: .12; font-family: Georgia, serif; line-height: 1;
    }
    .testi-card:hover { box-shadow: var(--shadow-hov); border-color: var(--primary); }
    .stars i { color: #f5a623; font-size: 13px; }
    .stars { margin-bottom: 12px; display: flex; gap: 3px; }
    .testi-text { font-size: 13.5px; color: var(--text-light); line-height: 1.72; margin-bottom: 18px; font-style: italic; }
    .testi-author { display: flex; align-items: center; gap: 12px; }
    .ava {
      width: 42px; height: 42px; border-radius: 50%; background: var(--primary);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 16px; font-weight: 700; flex-shrink: 0;
    }
    .ava-info h6 { font-size: 14px; font-weight: 700; margin-bottom: 1px; }
    .ava-info span { font-size: 12px; color: var(--text-muted); }

    /* ============================================================
       CLIENTS
    ============================================================ */
    .clients-sec { padding: 48px 0; background: #fff; border-top: 1px solid var(--border); }
    .clients-title { text-align: center; font-size: 13px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 28px; }
    .clients-row { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 36px 54px; }
    .c-logo { font-size: 17px; font-weight: 800; color: #bbb; letter-spacing: -.5px; transition: color .2s; font-family: 'Open Sans', sans-serif; }
    .c-logo:hover { color: var(--primary); }

    /* ============================================================
       NEWSLETTER
    ============================================================ */
    .newsletter { padding: 60px 0; background: linear-gradient(135deg, #1a4b6e, #2b76a6); }
    .nl-inner { max-width: 600px; margin: 0 auto; text-align: center; }
    .nl-inner h3 { font-size: 28px; font-weight: 800; color: #fff; margin-bottom: 10px; }
    .nl-inner p  { font-size: 15px; color: rgba(255,255,255,.85); margin-bottom: 28px; }
    .nl-form { display: flex; gap: 10px; max-width: 460px; margin: 0 auto; flex-wrap: wrap; }
    .nl-form input {
      flex: 1; min-width: 200px; padding: 12px 18px;
      border: 2px solid rgba(255,255,255,.3); border-radius: 8px;
      background: rgba(255,255,255,.15); color: #fff; font-family: inherit;
      font-size: 14px; outline: none; transition: border-color .2s;
    }
    .nl-form input::placeholder { color: rgba(255,255,255,.6); }
    .nl-form input:focus { border-color: rgba(255,255,255,.7); }
    .nl-form button {
      padding: 12px 22px; background: var(--accent); color: #fff;
      border: none; border-radius: 8px; font-weight: 700; font-size: 14px;
      cursor: pointer; transition: background .2s; font-family: inherit;
    }
    .nl-form button:hover { background: var(--accent-dark); }

    /* ============================================================
       FOOTER
    ============================================================ */
    footer { background: #1a2a3a; color: rgba(255,255,255,.8); }
    .footer-main { padding: 56px 0 38px; }
    .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }

    .f-logo { display: flex; flex-direction: column; line-height: 1.1; margin-bottom: 14px; }
    .f-logo .fn { font-size: 22px; font-weight: 800; color: #fff; }
    .f-logo .fs { font-size: 11px; color: var(--accent); font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
    .f-desc { font-size: 13.5px; color: rgba(255,255,255,.62); line-height: 1.72; margin-bottom: 20px; }

    /* Social icons */
    .f-social { display: flex; gap: 9px; flex-wrap: wrap; }
    .f-soc-icon {
      width: 36px; height: 36px; border-radius: 8px;
      background: rgba(255,255,255,.09); display: flex; align-items: center;
      justify-content: center; color: rgba(255,255,255,.72); font-size: 15px;
      transition: all .2s; text-decoration: none;
    }
    .f-soc-icon:hover { color: #fff; }
    .f-soc-icon.fb:hover  { background: #1877f2; }
    .f-soc-icon.ig:hover  { background: linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); }
    .f-soc-icon.tw:hover  { background: #1da1f2; }
    .f-soc-icon.li:hover  { background: #0077b5; }
    .f-soc-icon.yt:hover  { background: #ff0000; }
    .f-soc-icon.wa:hover  { background: var(--wp-green); }

    .f-col h6 { font-size: 13.5px; font-weight: 800; color: #fff; margin-bottom: 18px; text-transform: uppercase; letter-spacing: .8px; }
    .f-col ul li { margin-bottom: 9px; }
    .f-col ul li a { font-size: 13.5px; color: rgba(255,255,255,.62); transition: all .2s; display: flex; align-items: center; gap: 7px; }
    .f-col ul li a i { font-size: 10px; color: var(--accent); }
    .f-col ul li a:hover { color: #fff; padding-left: 4px; }
    .f-contact-item { display: flex; gap: 11px; margin-bottom: 13px; font-size: 13.5px; color: rgba(255,255,255,.62); }
    .f-contact-item i { color: var(--accent); margin-top: 2px; flex-shrink: 0; }
    .f-contact-item a { color: rgba(255,255,255,.85); }
    .f-contact-item a:hover { color: #fff; }

    .footer-bot {
      border-top: 1px solid rgba(255,255,255,.1); padding: 16px 0;
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    }
    .footer-bot p { font-size: 13px; color: rgba(255,255,255,.45); margin: 0; }
    .footer-bot a { color: rgba(255,255,255,.55); margin: 0 7px; font-size: 13px; }
    .footer-bot a:hover { color: #fff; }
    .pay-icons { display: flex; gap: 7px; align-items: center; flex-wrap: wrap; }
    .pay-badge { background: rgba(255,255,255,.12); border-radius: 4px; padding: 4px 9px; font-size: 11px; font-weight: 700; color: rgba(255,255,255,.7); }

    /* ============================================================
       CART MODAL
    ============================================================ */
    .cart-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.5);
      z-index: 2000; display: none; align-items: flex-start; justify-content: flex-end;
    }
    .cart-overlay.open { display: flex; }
    .cart-panel {
      width: min(420px, 95vw); height: 100vh; background: #fff;
      display: flex; flex-direction: column; box-shadow: -4px 0 40px rgba(0,0,0,.2);
      animation: slideIn .3s ease;
    }
    @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
    .cart-hdr {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 20px; border-bottom: 1px solid var(--border);
    }
    .cart-hdr h3 { font-size: 18px; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 10px; }
    .cart-close { background: none; border: none; font-size: 22px; cursor: pointer; color: var(--text-light); padding: 4px 8px; border-radius: 4px; }
    .cart-close:hover { background: var(--bg-light); }
    .cart-body { flex: 1; overflow-y: auto; padding: 16px; }
    .cart-empty { text-align: center; padding: 50px 20px; color: var(--text-muted); }
    .cart-empty i { font-size: 52px; margin-bottom: 14px; opacity: .3; }
    .cart-empty p { font-size: 15px; }
    .cart-item {
      display: flex; gap: 14px; padding: 14px 0;
      border-bottom: 1px solid var(--border); align-items: flex-start;
    }
    .cart-item-icon {
      width: 58px; height: 58px; border-radius: 8px; background: var(--bg-light);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 22px; color: var(--primary);
    }
    .cart-item-info { flex: 1; min-width: 0; }
    .cart-item-info h5 { font-size: 14px; font-weight: 700; margin-bottom: 3px; }
    .cart-item-info .ci-detail { font-size: 12.5px; color: var(--text-muted); margin-bottom: 6px; }
    .cart-item-info .ci-price { font-size: 14px; font-weight: 800; color: var(--primary); }
    .cart-item-qty { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
    .qty-btn {
      width: 28px; height: 28px; border: 1.5px solid var(--border);
      border-radius: 6px; background: #fff; cursor: pointer;
      font-size: 16px; display: flex; align-items: center; justify-content: center;
      transition: all .2s;
    }
    .qty-btn:hover { background: var(--primary); color: #fff; border-color: var(--primary); }
    .qty-val { font-size: 14px; font-weight: 700; min-width: 24px; text-align: center; }
    .cart-item-del { background: none; border: none; color: #e53935; cursor: pointer; font-size: 16px; padding: 4px; }
    .cart-item-del:hover { opacity: .7; }
    .cart-footer { padding: 16px 20px; border-top: 1px solid var(--border); }
    .cart-total { display: flex; justify-content: space-between; margin-bottom: 14px; font-size: 16px; font-weight: 700; }
    .cart-total span:last-child { color: var(--primary); font-size: 18px; }
    .cart-footer .btn { width: 100%; justify-content: center; font-size: 15px; padding: 14px; margin-bottom: 10px; }
    .cart-footer .btn i { font-size: 18px; }

    /* ============================================================
       ORDER MODAL (name + address form)
    ============================================================ */
    .order-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.55);
      z-index: 3000; display: none; align-items: center; justify-content: center; padding: 16px;
    }
    .order-overlay.open { display: flex; }
    .order-modal {
      background: #fff; border-radius: var(--radius-lg);
      width: min(500px, 100%); max-height: 90vh; overflow-y: auto;
      box-shadow: 0 20px 60px rgba(0,0,0,.25); animation: popIn .3s ease;
    }
    @keyframes popIn { from { transform: scale(.92); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .om-hdr { padding: 20px 24px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .om-hdr h3 { font-size: 18px; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 10px; }
    .om-hdr h3 i { color: var(--wp-green); }
    .om-close { background: none; border: none; font-size: 22px; cursor: pointer; color: var(--text-light); }
    .om-body { padding: 20px 24px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 6px; }
    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%; padding: 10px 14px; border: 1.5px solid var(--border);
      border-radius: var(--radius); font-family: inherit; font-size: 14px; color: var(--text);
      outline: none; transition: border-color .2s; resize: vertical;
    }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus { border-color: var(--primary); }
    .om-summary { background: var(--bg-light); border-radius: var(--radius); padding: 14px; margin-bottom: 16px; }
    .om-summary h6 { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); font-weight: 700; margin-bottom: 10px; }
    .om-sum-item { display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 6px; }
    .mug-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 3100;
      display: none; align-items: center; justify-content: center; padding: 16px;
    }
    .mug-overlay.open { display: flex; }
    .mug-modal { background: #fff; border-radius: var(--radius-lg); width: min(560px, 100%); max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.25); animation: popIn .3s ease; }
    .mug-choice { display: flex; gap: 12px; align-items: flex-start; border: 1.5px solid var(--border); border-radius: var(--radius); padding: 13px; margin-bottom: 10px; cursor: pointer; transition: all .2s; }
    .mug-choice:hover, .mug-choice.selected { border-color: var(--primary); background: rgba(43,118,166,.06); }
    .mug-choice input { margin-top: 3px; accent-color: var(--primary); }
    .mug-choice strong { display: block; font-size: 13.5px; margin-bottom: 3px; }
    .mug-choice small { color: var(--text-light); font-size: 12px; line-height: 1.45; }
    .mug-upload { display: none; margin: 14px 0 4px; padding: 14px; border: 1.5px dashed var(--primary); border-radius: var(--radius); background: #f7fbff; }
    .mug-upload.show { display: block; }
    .legacy-fields { display: none !important; }
    .legacy-fields + .om-footer { display: none !important; }
    .mug-upload label { display: block; font-size: 13px; font-weight: 700; color: var(--primary-dark); margin-bottom: 8px; }
    .mug-upload input { width: 100%; font-size: 13px; }
    .order-upload { padding: 13px; border: 1.5px dashed var(--primary); border-radius: var(--radius); background: #f7fbff; }
    .order-upload label { display: block; font-size: 13px; font-weight: 700; color: var(--primary-dark); margin-bottom: 7px; }
    .order-upload input { width: 100%; font-size: 13px; }
    .upload-help { display: block; color: var(--text-light); font-size: 11.5px; line-height: 1.45; margin-top: 6px; }
    .radio-stack { display: grid; gap: 8px; }
    .radio-option { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-light); }
    .radio-option input { accent-color: var(--primary); }
    .form-note { margin: -4px 0 16px; padding: 10px 12px; border-left: 3px solid var(--accent); background: #fff8ef; color: var(--text-light); font-size: 12px; line-height: 1.45; }
    .location-box { margin-top: 10px; padding: 11px 12px; border: 1px dashed var(--primary); border-radius: var(--radius); background: #f7fbff; }
    .location-btn { display: inline-flex; align-items: center; gap: 7px; padding: 8px 12px; border: 0; border-radius: 6px; background: var(--primary); color: #fff; font: 700 12px inherit; cursor: pointer; }
    .location-btn:disabled { opacity: .65; cursor: wait; }
    .location-status { display: block; margin-top: 7px; color: var(--text-light); font-size: 11.5px; line-height: 1.4; }
    .location-status.success { color: #16804f; }
    .location-status.error { color: #b42318; }
    .asset-preview { display: none; align-items: center; gap: 12px; margin-top: 12px; padding: 10px; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; }
    .asset-preview.show { display: flex; }
    .asset-preview img { width: 64px; height: 64px; object-fit: cover; border-radius: 6px; background: var(--bg-light); }
    .asset-preview-info { min-width: 0; flex: 1; }
    .asset-preview-info strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12.5px; }
    .asset-preview-info small { color: var(--text-light); font-size: 11px; }
    .asset-preview-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 5px; }
    .asset-preview-actions button { border: 0; background: none; padding: 0; color: var(--primary); cursor: pointer; font: 700 11px inherit; }
    .asset-preview-actions button.remove { color: #c62828; }
    .preview-overlay { position: fixed; inset: 0; z-index: 5000; display: none; align-items: center; justify-content: center; padding: 18px; background: rgba(0,0,0,.78); }
    .preview-overlay.open { display: flex; }
    .preview-overlay img { max-width: min(100%, 900px); max-height: 88vh; object-fit: contain; border-radius: 8px; }
