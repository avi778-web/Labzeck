      <button class="cart-close" onclick="closeCart()">×</button>
    </div>
    <div class="cart-body" id="cartBody">
      <div class="cart-empty" id="cartEmpty">
        <i class="fas fa-shopping-cart" style="font-size:40px;margin-bottom:10px;opacity:.3"></i>
        <p>Your cart is empty.<br>Select any product to start.</p>
      </div>
    </div>
    <div class="cart-footer" id="cartFooter" style="display:none">
      <div class="cart-total"><span>Total:</span><span id="cartTotalAmt">₹0</span></div>
      <button class="btn btn-wp" onclick="openOrderModal()"><i class="fab fa-whatsapp"></i> Order via WhatsApp</button>
    </div>
  </div>
</div>

<!-- ORDER MODAL -->
<div class="order-overlay" id="orderOverlay" onclick="if(event.target===this)closeOrderModal()">
  <div class="order-modal">
    <div class="om-hdr">
      <h3><i class="fab fa-whatsapp" style="color:var(--wp-green)"></i> Confirm WhatsApp Order</h3>
      <button class="om-close" onclick="closeOrderModal()">×</button>
    </div>
    <div class="om-body">
      <form id="orderForm" onsubmit="submitOrder(event)">
        <div class="form-group">
          <label>Order Type *</label>
          <select id="orderType" required><option value="standard">Standard order to database</option><option value="bulk">Bulk order to WhatsApp only</option></select>
        </div>
        <div class="form-group">
          <label>Your Name *</label>
          <input type="text" id="custName" placeholder="e.g. Rahul Sharma" required>
        </div>
        <div class="form-group">
          <label>Contact Number *</label>
          <input type="tel" id="custPhone" placeholder="e.g. 9876543210" required>
        </div>
        <div class="form-group">
          <label>Delivery Address *</label>
          <textarea id="custAddress" rows="3" placeholder="Enter full address with PIN code" required></textarea>
        </div>
        <div class="form-group">
          <label>Payment Method *</label>
          <select id="paymentMethod" required><option value="UPI">UPI</option><option value="PhonePe">PhonePe</option><option value="Razorpay">Razorpay</option><option value="GPay">GPay</option><option value="UPI QR Code">UPI QR Code</option></select>
        </div>
        <div class="form-group">
          <label>Special Instructions / Printing Notes</label>
          <textarea id="custNotes" rows="2" placeholder="Quantity details, color specifications, etc."></textarea>
        </div>
        <div class="delivery-summary"><span><s>₹50</s> delivery charge</span><strong>FREE Delivery</strong></div>
        <div class="om-footer" style="padding:16px 0 0;border-top:1px solid var(--border)">
          <button type="submit" class="btn btn-wp" id="orderSubmitBtn"><i class="fas fa-check"></i> Submit Order</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- FLOATING BUTTONS -->
<a href="https://wa.me/918447459316" target="_blank" class="wp-float" title="Chat on WhatsApp">
  <i class="fab fa-whatsapp"></i>
</a>
<button class="btt-btn" onclick="window.scrollTo({top:0,behavior:'smooth'})">
  <i class="fas fa-chevron-up"></i>
</button>

<script>
  let cart = [];

  function addToCart(name, price, bundle = '') {
    const lineName = bundle ? `${name} — ${bundle}` : name;
    const existing = cart.find(i => i.name === lineName);
    if (existing) {
      existing.qty++;
    } else {
      cart.push({ name: lineName, price, qty: 1 });
    }
    updateCartUI();
    openCart();
  }

  function updateCartUI() {
    const count = cart.reduce((s, i) => s + i.qty, 0);
    document.getElementById('cartBadge').textContent = count;
    const body = document.getElementById('cartBody');
    const footer = document.getElementById('cartFooter');
    const empty = document.getElementById('cartEmpty');

    if (cart.length === 0) {
      empty.style.display = 'block';
      footer.style.display = 'none';
      body.innerHTML = '';
      body.appendChild(empty);
    } else {
      empty.style.display = 'none';
      footer.style.display = 'block';
      body.innerHTML = '';
      let total = 0;
      cart.forEach(item => {
        total += item.price * item.qty;
        const div = document.createElement('div');
        div.style.cssText = 'display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #eee;';
        div.innerHTML = `
          <div>
            <strong>${item.name}</strong>
            <div style="font-size:12px;color:#777">₹${item.price} × ${item.qty}</div>
          </div>
          <div style="font-weight:700;color:var(--primary)">₹${item.price * item.qty}</div>
        `;
        body.appendChild(div);
      });
      document.getElementById('cartTotalAmt').textContent = '₹' + total;
    }
  }

  function openCart() { document.getElementById('cartOverlay').classList.add('open'); }
  function closeCart() { document.getElementById('cartOverlay').classList.remove('open'); }
  function openOrderModal() { closeCart(); document.getElementById('orderOverlay').classList.add('open'); }
  function closeOrderModal() { document.getElementById('orderOverlay').classList.remove('open'); }

  async function submitOrder(e) {
    e.preventDefault();
    const type = document.getElementById('orderType').value;
    const name = document.getElementById('custName').value.trim();
    const phone = document.getElementById('custPhone').value.trim();
    const address = document.getElementById('custAddress').value.trim();
    const notes = document.getElementById('custNotes').value.trim();
    const paymentMethod = document.getElementById('paymentMethod').value;
    const total = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
    if (!cart.length || !name || !phone || !address) return alert('Please complete all order details and add a product.');
    let location = {};
    if (navigator.geolocation) {
      try { const position = await new Promise((resolve, reject) => navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 5000 })); location = { latitude: position.coords.latitude, longitude: position.coords.longitude }; } catch (_) { console.warn('Location permission unavailable; address will be saved.'); }
    }
    const itemsList = cart.map(item => `${item.name} (Qty: ${item.qty}) - ₹${item.price * item.qty}`).join('\n');
    if (type === 'bulk') {
      const message = `*BULK ORDER - SK GRAPHICS*\n------------------------\n*Customer:* ${name}\n*Phone:* ${phone}\n*Address:* ${address}\n\n*Items:*\n${itemsList}\n*Total Estimate:* ₹${total}\n*Payment:* ${paymentMethod}\n*Notes:* ${notes || 'None'}\n------------------------`;
      window.open(`https://wa.me/918447459316?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    } else {
      const button = document.getElementById('orderSubmitBtn');
      button.disabled = true;
      try {
        const response = await fetch('/api/orders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ customer: { name, phone, address, location }, items: cart, total, notes: `${notes}${notes ? ' | ' : ''}Payment: ${paymentMethod}`, paymentMethod, deliveryFee: 0 }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Order could not be saved');
        alert(`Order saved successfully. Order ID: ${result.orderId}`);
      } catch (error) {
        button.disabled = false;
        alert(error.message || 'Order could not be saved. Please try again.');
        return;
      }
    }
    cart = [];
    updateCartUI();
    closeOrderModal();
    document.getElementById('orderForm').reset();
  }

  /* Driver GPS sync hook (admin/driver phone connection) */
  function updateDriverLocation(lat, lng) {
    console.log("Driver location received:", lat, lng);
    // Realtime driver update hook (WebSocket / Socket.io / Firebase)
  }
</script>
</body>
</html>
