}
function toggleProductUploads() {
  document.getElementById('productUploadBox').classList.toggle('show', document.getElementById('productUploadCheck').checked);
}
async function uploadAssetIfConfigured(file) {
  if (!file) return '';
  var endpoint = window.SK_GRAPHICS_UPLOAD_ENDPOINT || '';
  var body = new FormData();
  body.append('file', file);
  // Cloudinary's /auto/upload endpoint supports images, PDFs and documents.
  // The unsigned preset must remain public; never put api_secret in this HTML.
  body.append('resource_type', 'auto');
  body.append('secure', 'true');
  if (!endpoint) {
    var cloudinary = window.SK_GRAPHICS_CLOUDINARY || {};
    if (!cloudinary.cloudName || !cloudinary.uploadPreset) throw new Error('Cloud upload is not configured');
    endpoint = 'https://api.cloudinary.com/v1_1/' + encodeURIComponent(cloudinary.cloudName) + '/auto/upload';
    body.append('upload_preset', cloudinary.uploadPreset);
    body.append('folder', 'sk-graphics/orders');
  }
  var response = await fetch(endpoint, { method: 'POST', body: body });
  if (!response.ok) throw new Error('Cloudinary upload failed (' + response.status + ')');
  var result = await response.json();
  var publicUrl = result.secure_url || (result.data && result.data.secure_url) || '';
  if (!/^https:\/\//i.test(publicUrl)) throw new Error('Cloudinary did not return a public HTTPS URL');
  return publicUrl;
}
async function saveProductCustomization(e) {
  e.preventDefault();
  if (!pendingProduct) return;
  var form = document.getElementById('productCustomizationForm');
  var formData = new FormData(form), details = {};
  formData.forEach(function (value, key) { if (typeof value === 'string' && value.trim()) details[key] = value.trim(); });
  var designFile = document.getElementById('productDesignFile').files[0];
  var photoFile = document.getElementById('productPhotoFile').files[0];
  var uploadEnabled = document.getElementById('productUploadCheck').checked;
  var deliveryCharge = details.packageOption && details.packageOption.indexOf('Both Gift Boxes') === 0 ? 50 : 0;
  var submitButton = document.getElementById('productSubmitButton');
  var originalButtonText = submitButton.innerHTML;
  submitButton.disabled = true;
  submitButton.textContent = 'Preparing Files...';
  var designUrl = '', photoUrl = '';
  try {
    designUrl = uploadEnabled && designFile ? await uploadAssetIfConfigured(designFile) : '';
    photoUrl = uploadEnabled && photoFile ? await uploadAssetIfConfigured(photoFile) : '';
  } catch (uploadError) {
    submitButton.disabled = false;
    submitButton.innerHTML = originalButtonText;
    alert('File upload failed. Please check the public unsigned Cloudinary upload preset. WhatsApp requires a publicly accessible HTTPS URL.');
    return;
  }
  submitButton.disabled = false;
  submitButton.innerHTML = originalButtonText;
  cart.push({ name: pendingProduct.name, price: pendingProduct.price, qty: 1, customization: { category: pendingProduct.category, details: details, packagingDeliveryCharge: deliveryCharge, designFile: uploadEnabled && designFile ? designFile.name : '', photoFile: uploadEnabled && photoFile ? photoFile.name : '', designUrl: designUrl, photoUrl: photoUrl, designBlob: uploadEnabled ? designFile : null, photoBlob: uploadEnabled ? photoFile : null } });
  updateCartUI();
  closeMugOptions();
  openCart();
}

function addToCart(name, price) {
  openProductOptions(name, price);
}

function removeFromCart(name) {
  cart = cart.filter(i => i.name !== name);
  updateCartUI();
}

function changeQty(name, delta) {
  var item = cart.find(i => i.name === name);
  if (!item) return;
  item.qty += delta;
  if (item.qty <= 0) removeFromCart(name);
  else updateCartUI();
}

function getCartTotal() {
  return cart.reduce((s, i) => s + i.price * i.qty, 0);
}

function updateCartUI() {
  var count = cart.reduce((s, i) => s + i.qty, 0);
  document.getElementById('cartBadge').textContent = count;
  document.getElementById('mobCartCount').textContent = count;

  var body = document.getElementById('cartBody');
  var footer = document.getElementById('cartFooter');
  var empty = document.getElementById('cartEmpty');

  if (cart.length === 0) {
    empty.style.display = 'block';
    footer.style.display = 'none';
    body.innerHTML = '';
    body.appendChild(empty);
  } else {
    empty.style.display = 'none';
    footer.style.display = 'block';

    // Re-render items
    // Remove old items
    body.querySelectorAll('.cart-item').forEach(el => el.remove());

    cart.forEach(function(item) {
      var div = document.createElement('div');
      div.className = 'cart-item';
      div.id = 'ci-' + item.name.replace(/[^a-z0-9]/gi,'');
      div.innerHTML =
        '<div class="cart-item-icon"><i class="fas fa-print"></i></div>' +
        '<div class="cart-item-info">' +
          '<h5>' + item.name + '</h5>' +
          '<div class="ci-detail">Unit price: ₹' + item.price + '</div>' +
          '<div class="ci-price">₹' + (item.price * item.qty) + '</div>' +
          '<div class="cart-item-qty">' +
            '<button class="qty-btn" onclick="changeQty(\'' + item.name + '\',-1)">−</button>' +
            '<span class="qty-val">' + item.qty + '</span>' +
            '<button class="qty-btn" onclick="changeQty(\'' + item.name + '\',1)">+</button>' +
          '</div>' +
        '</div>' +
        '<button class="cart-item-del" onclick="removeFromCart(\'' + item.name + '\')" title="Remove"><i class="fas fa-trash-alt"></i></button>';
      body.appendChild(div);
    });

    document.getElementById('cartTotalAmt').textContent = '₹' + getCartTotal();
  }
}

function openCart() {
  document.getElementById('cartOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeCart() {
  document.getElementById('cartOverlay').classList.remove('open');
  document.body.style.overflow = '';
}
function closeCartOutside(e) {
  if (e.target === document.getElementById('cartOverlay')) closeCart();
}

/* ==================================
   ORDER MODAL
================================== */
function getOrderPricing() {
  var base = cart.reduce(function (sum, item) { return sum + item.price * item.qty; }, 0);
  var delivery = cart.length ? 50 : 0;
  cart.forEach(function (item) { if (item.customization && item.customization.packagingDeliveryCharge) delivery += item.customization.packagingDeliveryCharge; });
  return { base: base, delivery: delivery, total: base + delivery };
}
function openOrderModal() {
  if (cart.length === 0) {
    alert('Your cart is empty! Please add products first.');
    return;
  }
  closeCart();
  customerLocation = null;
  document.getElementById('locationStatus').textContent = 'Optional: allow location access to share an exact Google Maps link with the owner.';
  document.getElementById('locationStatus').className = 'location-status';
  document.getElementById('getLocationBtn').disabled = false;

  // Build summary
  var summaryHtml = '';
  cart.forEach(function(item) {
    summaryHtml += '<div class="om-sum-item"><span>' + item.name + ' × ' + item.qty + '</span><span>₹' + (item.price * item.qty) + '</span></div>';
  });
  document.getElementById('omSummaryItems').innerHTML = summaryHtml;
  var pricing = getOrderPricing();
  document.getElementById('omTotal').textContent = '₹' + pricing.total;
  document.getElementById('orderBreakdown').innerHTML = '<div><span>Base Product Price</span><strong>₹' + pricing.base + '</strong></div><div><span>Delivery Charge</span><strong>₹' + pricing.delivery + '</strong></div>';
  document.querySelector('input[name="paymentMethod"][value="cod"]').checked = true;
  document.getElementById('orderOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeOrderModal() {
  document.getElementById('orderOverlay').classList.remove('open');
  document.body.style.overflow = '';
}
function closeOrderOutside(e) {
  if (e.target === document.getElementById('orderOverlay')) closeOrderModal();
}

function getLiveLocation() {
  var button = document.getElementById('getLocationBtn');
  var status = document.getElementById('locationStatus');
  if (!navigator.geolocation) {
    status.textContent = 'This browser does not support live location.';
    status.className = 'location-status error';
    return Promise.resolve('');
  }
  button.disabled = true;
  status.textContent = 'Requesting location permission...';
  status.className = 'location-status';
  return new Promise(function (resolve) {
    navigator.geolocation.getCurrentPosition(function (position) {
      var latitude = Number(position.coords.latitude).toFixed(6);
      var longitude = Number(position.coords.longitude).toFixed(6);
      var mapsLink = 'https://maps.google.com/?q=' + latitude + ',' + longitude;
      customerLocation = { latitude: latitude, longitude: longitude, mapsLink: mapsLink };
      button.disabled = false;
      status.innerHTML = '<i class="fas fa-check-circle"></i> Location captured. <a href="' + mapsLink + '" target="_blank" rel="noopener">View on Google Maps</a>';
      status.className = 'location-status success';
      resolve(mapsLink);
    }, function (error) {
      customerLocation = null;
      button.disabled = false;
      status.textContent = error.code === 1 ? 'Location permission was denied. You can still submit with the typed address.' : 'Could not fetch location. You can still submit with the typed address.';
      status.className = 'location-status error';
      resolve('');
    }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 });
  });
}

/* Direct single-file order helper. The main cart flow calls sendWhatsApp below;
   this helper is available for simple forms that submit one file directly. */
async function handleOrderSubmit(event, file, orderDetails, customerName) {
  if (event) event.preventDefault();
  try {
    var publicImageUrl = file ? await uploadAssetIfConfigured(file) : '';
    var mapsLink = customerLocation ? customerLocation.mapsLink : await getLiveLocation();
    var ownerPhoneNumber = '918447459316';
    var message =
      'SK GRAPHICS | NEW CUSTOM ORDER\n' +
      '==============================\n' +
      'Customer: ' + (customerName || 'N/A') + '\n\n' +
      'Order details / text:\n' + (orderDetails || 'N/A') + '\n\n' +
      'Customer location:\n' + (mapsLink || 'Live location not shared') + '\n\n' +
      'Design / photo public HTTPS link:\n' + (publicImageUrl || 'No file uploaded') + '\n\n' +
      'Please review and confirm this order.\n' +
      'SK Graphics';
    window.open('https://wa.me/' + ownerPhoneNumber + '?text=' + encodeURIComponent(message), '_blank');
    return { success: true, imageUrl: publicImageUrl };
  } catch (error) {
    console.error('Order submission error:', error);
    alert('File upload failed: ' + error.message);
    return { success: false, error: error };
  }
}

async function sendWhatsApp(e) {
  e.preventDefault();
  var name    = document.getElementById('custName').value.trim();
  var phone   = document.getElementById('custPhone').value.trim();
  var email   = document.getElementById('custEmail').value.trim();
  var address = document.getElementById('custAddress').value.trim();
  var notes   = document.getElementById('custNotes').value.trim();
  var paymentMethod = 'Cash on Delivery (COD)';
  var pricing = getOrderPricing();
  var mapsLink = customerLocation ? customerLocation.mapsLink : await getLiveLocation();

  // Build order lines
  var orderLines = '';
  var fileLines = '';
  cart.forEach(function(item) {
    orderLines += '  • ' + item.name + ' × ' + item.qty + '  = ₹' + (item.price * item.qty) + '\n';
    if (item.customization) {
      orderLines += '    Product Category: ' + item.customization.category + '\n';
      Object.keys(item.customization.details).forEach(function (key) {
        orderLines += '    ' + key + ': ' + item.customization.details[key] + '\n';
      });
      if (item.customization.designUrl) fileLines += 'Design File: ' + item.customization.designUrl + '\n';
      if (item.customization.photoUrl) fileLines += 'Photo File: ' + item.customization.photoUrl + '\n';
    }
  });

  var msg =
    '🛍️ *NEW ORDER - SK GRAPHICS*\n' +
    '----------------------------------------\n' +
    '👤 *Customer:* ' + name + '\n' +
    '📞 *Phone:* ' + phone + '\n' +
    (email ? '📧 *Email:* ' + email + '\n' : '') +
    '📍 *Delivery Address:*\n' + address + '\n' +
    '📦 *Product:* ' + (cart.length === 1 ? cart[0].name : 'Multiple Products') + '\n' +
    '📋 *Specifications:*\n' + orderLines +
    '💳 *Payment Method:* ' + paymentMethod + '\n' +
    '💰 *Total Amount Payable:* ₹' + pricing.total + '\n' +
    '📝 *Custom Instructions:* ' + (notes || 'N/A') + '\n' +
    '🖼️ *Customer Photo/Design Link:* ' + (fileLines || 'N/A - no upload selected') +
    '----------------------------------------\n' +
    'Brand: SK Graphics';

  // Owner-friendly WhatsApp format. Plain HTTPS URLs are kept on their own
  // lines so WhatsApp can make them clickable and generate a preview.
  msg =
    'SK GRAPHICS | NEW ORDER\n' +
    '========================\n' +
    'CUSTOMER\n' +
    'Name: ' + name + '\n' +
    'Phone: ' + phone + '\n' +
    (email ? 'Email: ' + email + '\n' : '') +
    'Address: ' + address + '\n\n' +
    'LOCATION\n' + (mapsLink || 'Live location not shared') + '\n\n' +
    'ORDER\n' + orderLines + '\n' +
    'Payment: ' + paymentMethod + '\n' +
    'Delivery: INR ' + pricing.delivery + '\n' +
    'TOTAL: INR ' + pricing.total + '\n\n' +
    'CUSTOM INSTRUCTIONS\n' + (notes || 'N/A') + '\n\n' +
    'FILE / PREVIEW LINKS\n' + (fileLines || 'No file uploaded') + '\n' +
    'Open the HTTPS link above to view the uploaded design/photo.\n\n' +
    'Please review and confirm this order.\n' +
    'SK Graphics';

  var shareFiles = [];
  cart.forEach(function (item) {
    if (!item.customization) return;
    if (item.customization.designBlob) shareFiles.push(item.customization.designBlob);
    if (item.customization.photoBlob) shareFiles.push(item.customization.photoBlob);
  });
  var url = 'https://wa.me/918447459316?text=' + encodeURIComponent(msg);
  // navigator.share sends the original file to WhatsApp. The Cloudinary URL
  // remains in the message so the file is also available as a public HTTPS link.
  if (shareFiles.length && navigator.share && (!navigator.canShare || navigator.canShare({ files: shareFiles }))) {
    try {
      await navigator.share({ title: 'SK Graphics Order', text: msg, files: shareFiles });
    } catch (shareError) {
      if (shareError.name !== 'AbortError') window.open(url, '_blank');
    }
  } else {
    window.open(url, '_blank');
    if (shareFiles.length) alert('WhatsApp text opened. Please choose Attach > Document and select the original photo/design file in the same chat.');
  }
  closeOrderModal();
  cart = [];
  updateCartUI();
  document.getElementById('orderForm').reset();
}

function showSelectedFileName(inputId, labelId, emptyText) {
  var input = document.getElementById(inputId);
  var label = document.getElementById(labelId);
  if (!input || !label) return;
  input.addEventListener('change', function () {
    label.textContent = this.files[0] ? 'Selected: ' + this.files[0].name : emptyText;
  });
}
var assetPreviewUrls = { design: '', photo: '' };
function formatFileSize(bytes) {
  if (!bytes) return '0 B';
  var units = ['B', 'KB', 'MB', 'GB'], index = Math.floor(Math.log(bytes) / Math.log(1024));
  return (bytes / Math.pow(1024, index)).toFixed(index ? 1 : 0) + ' ' + units[index];
}
function setupAssetPreview(kind, inputId, previewId, imageId, nameId, metaId, emptyText) {
  var input = document.getElementById(inputId);
  if (!input) return;
  input.addEventListener('change', function () {
    var file = this.files[0], card = document.getElementById(previewId);
    if (!file) { card.classList.remove('show'); return; }
    if (assetPreviewUrls[kind]) URL.revokeObjectURL(assetPreviewUrls[kind]);
    assetPreviewUrls[kind] = URL.createObjectURL(file);
    document.getElementById(nameId).textContent = file.name;
    document.getElementById(metaId).textContent = formatFileSize(file.size) + (file.type ? ' • ' + file.type : '');
    var image = document.getElementById(imageId);
    image.src = file.type.indexOf('image/') === 0 ? assetPreviewUrls[kind] : '';
    image.alt = file.type.indexOf('image/') === 0 ? file.name : 'Document selected: ' + file.name;
    card.classList.add('show');
  });
}
function viewAssetPreview(kind) {
  if (!assetPreviewUrls[kind]) return;
  document.getElementById('assetPreviewImage').src = assetPreviewUrls[kind];
  document.getElementById('assetPreviewOverlay').classList.add('open');
}
function closeAssetPreview(e) {
  if (!e || e.target === document.getElementById('assetPreviewOverlay')) document.getElementById('assetPreviewOverlay').classList.remove('open');
}
function removeAsset(kind) {
  var inputId = kind === 'photo' ? 'productPhotoFile' : 'productDesignFile';
  var previewId = kind === 'photo' ? 'photoPreview' : 'designPreview';
  document.getElementById(inputId).value = '';
  document.getElementById(previewId).classList.remove('show');
  if (assetPreviewUrls[kind]) URL.revokeObjectURL(assetPreviewUrls[kind]);
  assetPreviewUrls[kind] = '';
}
showSelectedFileName('productPhotoFile', 'productPhotoFileName', 'Upload a high-resolution image or logo.');
showSelectedFileName('productDesignFile', 'productDesignFileName', 'Upload an existing design or artwork.');
setupAssetPreview('photo', 'productPhotoFile', 'photoPreview', 'photoPreviewImage', 'photoPreviewName', 'photoPreviewMeta');
setupAssetPreview('design', 'productDesignFile', 'designPreview', 'designPreviewImage', 'designPreviewName', 'designPreviewMeta');
document.querySelectorAll('.legacy-fields, .legacy-fields + .om-footer').forEach(function (node) { node.remove(); });

/* ==================================
   HOW IT WORKS INTERACTIONS
================================== */
const artworkInput = document.getElementById('artworkFile');
const artworkDropzone = document.getElementById('artworkDropzone');
const artworkPreview = document.getElementById('artworkPreview');
const artworkName = document.getElementById('artworkName');

function showArtwork(file) {
  if (!file) return;
  const allowed = /\.(pdf|ai|psd)$/i.test(file.name);
  if (!allowed) { alert('Please upload a PDF, AI, or PSD file.'); return; }
  artworkName.textContent = file.name;
  artworkPreview.classList.add('show');
}
if (artworkInput) artworkInput.addEventListener('change', function () { showArtwork(this.files[0]); });
if (artworkDropzone) {
  ['dragenter','dragover'].forEach(function (eventName) {
    artworkDropzone.addEventListener(eventName, function (e) { e.preventDefault(); artworkDropzone.classList.add('is-dragover'); });
  });
  ['dragleave','drop'].forEach(function (eventName) {
    artworkDropzone.addEventListener(eventName, function (e) { e.preventDefault(); artworkDropzone.classList.remove('is-dragover'); });
  });
  artworkDropzone.addEventListener('drop', function (e) { showArtwork(e.dataTransfer.files[0]); });
}
function approvePrint() {
  var button = document.getElementById('approvePrintBtn');
  if (!button) return;
  button.textContent = '✓ Approved for Print';
  button.classList.add('approved');
}

