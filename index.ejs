  packaging: ['Upload Die-cut Template / Logo / Branding Files', 'Die-cut Template / Branding File', 'Logo / Branding Image', 'Add Customized Packaging'],
  posters: ['Upload Banner Design / High-Res Photos', 'Banner Design', 'High-Res Photos', 'Add Customized Banner / Standee'],
