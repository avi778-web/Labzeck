<script>
(function(){
  var stages=[{copy:'Your order is being prepared by our print studio.',eta:'Estimated arrival: Tomorrow, 11:30 AM',driver:'Driver details unlock when your order is out for delivery.',badge:'In production',left:'25%',top:'62%'},{copy:'Your prints are packed and quality checked.',eta:'Estimated arrival: Tomorrow, 11:30 AM',driver:'Packed securely and ready for dispatch.',badge:'Packed',left:'40%',top:'54%'},{copy:'Your order is on the way to your delivery address.',eta:'Arriving in 25 mins',driver:'Ravi Kumar · DL 01 AB 4821',badge:'Out for delivery',left:'68%',top:'40%'},{copy:'Delivered successfully. Thank you for choosing SK Graphics.',eta:'Delivered today at 10:42 AM',driver:'Delivered by Ravi Kumar · DL 01 AB 4821',badge:'Delivered',left:'78%',top:'28%'}];
  var buttons=[].slice.call(document.querySelectorAll('[data-stage]')); var steps=[].slice.call(document.querySelectorAll('.timeline-step')); var vehicle=document.querySelector('.vehicle');
  buttons.forEach(function(btn){btn.addEventListener('click',function(){var stage=Number(btn.dataset.stage); buttons.forEach(function(b){b.classList.toggle('active',b===btn)}); steps.forEach(function(s,i){s.classList.toggle('done',i<=stage)}); var data=stages[stage]; document.getElementById('trackingCopy').textContent=data.copy; document.getElementById('etaText').textContent=data.eta; document.getElementById('driverText').textContent=data.driver; document.getElementById('statusBadge').textContent=data.badge; vehicle.style.left=data.left; vehicle.style.top=data.top; });});
  var chat=document.getElementById('chatPanel'); document.getElementById('chatFab').onclick=function(){chat.classList.add('open')}; document.getElementById('chatClose').onclick=function(){chat.classList.remove('open')};
  function reply(question){var messages=document.getElementById('chatMessages'); var user=document.createElement('div'); user.className='chat-message user'; user.textContent=question; messages.appendChild(user); var answer='I can help you choose paper, finish, size and quantity. Tell me what you want to print.'; if(question.indexOf('पहुंच')>-1||question.indexOf('ट्रैक')>-1) answer='Order #SK-24081 is currently in production. Use the tracking stages above; once dispatched, the driver and live route will appear.'; if(question.indexOf('पेमेंट')>-1) answer='We accept UPI, cards, net banking and cash on delivery. Open checkout to choose your preferred method.'; var bot=document.createElement('div'); bot.className='chat-message bot'; bot.textContent=answer; messages.appendChild(bot); messages.scrollTop=messages.scrollHeight;}
  document.querySelectorAll('.chat-quick button').forEach(function(b){b.onclick=function(){reply(b.dataset.question)}}); document.getElementById('chatForm').onsubmit=function(e){e.preventDefault(); var input=document.getElementById('chatInput'); if(!input.value.trim())return; reply(input.value.trim()); input.value=''};
  var drawer=document.getElementById('checkoutDrawer'); document.getElementById('checkoutBtn').onclick=function(){drawer.classList.add('open')}; document.getElementById('checkoutClose').onclick=function(){drawer.classList.remove('open')}; drawer.onclick=function(e){if(e.target===drawer)drawer.classList.remove('open')}; document.getElementById('payBtn').onclick=function(){this.textContent='Payment flow ready'; this.disabled=true};
})();
</script>
