};
function openProductOptions(name, price) {
  pendingProduct = { name: name, price: price, category: getProductCategory(name) };
  var config = productFormConfig[pendingProduct.category];
  var fields = config ? config.fields.map(fieldMarkup).join('') : '<div class="form-group"><label>Product Details / Instructions</label><textarea name="details" rows="3" placeholder="Enter your customization requirements"></textarea></div>';
  var ui = productUiConfig[pendingProduct.category] || productUiConfig.generic;
  var title = name === 'Custom T-Shirts' ? 'Customize Your T-Shirt' : name === 'Custom Mugs' ? 'Customize Your Mug' : 'Customize ' + name;
  document.getElementById('productModalTitle').innerHTML = '<i class="fas fa-sliders-h" style="color:var(--accent)"></i> ' + title;
  document.getElementById('productSubmitButton').innerHTML = '<i class="fas fa-check"></i> ' + ui[3];
  document.getElementById('productUploadLabel').textContent = ui[0];
  document.getElementById('productDesignLabel').textContent = ui[1];
  document.getElementById('productPhotoLabel').textContent = ui[2];
  document.getElementById('masterProductFields').innerHTML = '<p style="font-size:13.5px;color:var(--text-light);margin-bottom:16px"><strong>Step 1: Product specifications</strong><br>Please share these specifications. Send your logo/photo/design on WhatsApp as a Document or HD file for best print quality.</p>' + fields;
  document.getElementById('productCustomizationForm').reset();
